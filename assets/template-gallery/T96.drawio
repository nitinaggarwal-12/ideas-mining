    <mxCell id="hdr_T96" value="&lt;div style='width:692px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEF3C7;color:#92400E;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #7 (T96) • WAIST-PINCHED PROTOCOL HOURGLASS • N×M TO N+M&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Multi-Cloud Agents: &lt;span style='color:#D97706;'&gt;The Protocol Hourglass&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Just as TCP/IP unified networks, &lt;b&gt;A2A + MCP&lt;/b&gt; forms the narrow &lt;b&gt;W.A.I.S.T.&lt;/b&gt; uniting N agents with M tools&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="696" height="110" as="geometry"/></mxCell>

