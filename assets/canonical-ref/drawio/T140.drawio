; stroke=&quot;#059669&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;643&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;LEVER 1 • +$20k BASE CAP&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;657&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Anchored via competing loop&lt;/text&gt;&lt;text x=&quot;227&quot; y=&quot;758&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;800&quot; fill=&quot;#64748B&quot; text-anchor=&quot;middle&quot;&gt;Accepting 1st Call = -$372k / 4 Yrs&lt;/text&gt;&lt;text x=&quot;704&quot; y=&quot;758&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;+$372,000 4-Year Wealth Delta&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T140" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#ECFDF5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #51 (T140) • LINKEDIN #1 SALARY SAVE MAGNET • 4-LEVER OFFER STACK&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;AI Offer Levers: &lt;span style='color:#059669;'&gt;+$93k O.F.F.E.R. Stack&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;When Base hits HR cap, pull the 3 unlocked equity &amp;amp; sign-on levers with the &lt;b&gt;O.F.F.E.R.&lt;/b&gt; total-comp stack&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

