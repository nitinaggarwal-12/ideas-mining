    <mxCell id="bg_T175" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT175&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT175&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT175)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT175&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT175)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;g filter=&quot;url(#softDropT175)&quot;&gt;&lt;rect x=&quot;50&quot; y=&quot;354&quot; width=&quot;388&quot; height=&quot;402&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#FCA5A5&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;68&quot; y=&quot;370&quot; width=&quot;352&quot; height=&quot;32&quot; rx=&quot;10&quot; fill=&quot;#FEF2F2&quot;/&gt;&lt;text x=&quot;244&quot; y=&quot;390.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;✕ OBSERVATIONAL LOGS:  P(Y | X) ≠ P(Y | do(X))&lt;/text&gt;&lt;!-- Top Confounder Node Z (Task Difficulty / Prompt Length) --&gt;&lt;ellipse cx=&quot;244&quot; cy=&quot;462&quot; rx=&quot;116&quot; ry=&quot;30&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;244&quot; y=&quot;458&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;CONFOUNDER  Z&lt;/text&gt;&lt;text x=&quot;244&quot; y=&quot;473&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;Easy vs. Hard User Query&lt;/text&gt;&lt;!-- Left Treatment Node X (Tool Use / Thinking) --&gt;&lt;ellipse cx=&quot;146&quot; cy=&quot;608&quot; rx=&quot;76&quot; ry=&quot;30&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;146&quot; y=&quot;604&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;TREATMENT X&lt;/text&gt;&lt;text x=&quot;146&quot; y=&quot;619&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Extra Tool Calls&lt;/text&gt;&lt;!-- Right Outcome Node Y (Task Success) --&gt;&lt;ellipse cx=&quot;342&quot; cy=&quot;608&quot; rx=&quot;76&quot; ry=&quot;30&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;342&quot; y=&quot;604&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;OUTCOME Y&lt;/text&gt;&lt;text x=&quot;342&quot; y=&quot;619&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Verified Answer&lt;/text&gt;&lt;!-- Z -&gt; Y Direct Confounding Edge --&gt;&lt;line x1=&quot;282&quot; y1=&quot;490&quot; x2=&quot;328&quot; y2=&quot;574&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.6&quot;/&gt;&lt;polygon points=&quot;321,572 331,580 331,567&quot; fill=&quot;#D97706&quot;/&gt;&lt;!-- Z -&gt; X Backdoor Edge (Active on Left, Severed by do(X) Surgery on Right!) --&gt;&lt;line x1=&quot;206&quot; y1=&quot;490&quot; x2=&quot;160&quot; y2=&quot;574&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;2.6&quot; /&gt;&lt;polygon points=&quot;157,567 157,580 167,572&quot; fill=&quot;#DC2626&quot;/&gt;&lt;rect x=&quot;118&quot; y=&quot;518&quot; width=&quot;114&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;175&quot; y=&quot;532.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;✕ Backdoor Bias&lt;/text&gt;&lt;!-- True Causal Edge X -&gt; Y --&gt;&lt;line x1=&quot;222&quot; y1=&quot;608&quot; x2=&quot;260&quot; y2=&quot;608&quot; stroke=&quot;#059669&quot; stroke-width=&quot;3.4&quot;/&gt;&lt;polygon points=&quot;256,602 268,608 256,614&quot; fill=&quot;#059669&quot;/&gt;&lt;!-- Equation Box --&gt;&lt;rect x=&quot;72&quot; y=&quot;662&quot; width=&quot;344&quot; height=&quot;72&quot; rx=&quot;12&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;244&quot; y=&quot;686&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;Naive Log Diff = −18% (&quot;Tools Hurt?!&quot;)&lt;/text&gt;&lt;text x=&quot;244&quot; y=&quot;706&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;800&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Reversal Paradox: Hard queries (Z) trigger&lt;/text&gt;&lt;text x=&quot;244&quot; y=&quot;722&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;more tool calls (X) AND fail more often (Y)!&lt;/text&gt;&lt;rect x=&quot;482&quot; y=&quot;354&quot; width=&quot;388&quot; height=&quot;402&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;500&quot; y=&quot;370&quot; width=&quot;352&quot; height=&quot;32&quot; rx=&quot;10&quot; fill=&quot;#ECFDF5&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;390.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;✓ INTERVENTIONAL SURGERY:  P(Y | do(X)) = ∑_z P(Y|X,z)P(z)&lt;/text&gt;&lt;!-- Top Confounder Node Z (Task Difficulty / Prompt Length) --&gt;&lt;ellipse cx=&quot;676&quot; cy=&quot;462&quot; rx=&quot;116&quot; ry=&quot;30&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;458&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;CONFOUNDER  Z&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;473&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;Easy vs. Hard User Query&lt;/text&gt;&lt;!-- Left Treatment Node X (Tool Use / Thinking) --&gt;&lt;ellipse cx=&quot;578&quot; cy=&quot;608&quot; rx=&quot;76&quot; ry=&quot;30&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;578&quot; y=&quot;604&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;do(X = 1)&lt;/text&gt;&lt;text x=&quot;578&quot; y=&quot;619&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Extra Tool Calls&lt;/text&gt;&lt;!-- Right Outcome Node Y (Task Success) --&gt;&lt;ellipse cx=&quot;774&quot; cy=&quot;608&quot; rx=&quot;76&quot; ry=&quot;30&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;774&quot; y=&quot;604&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;OUTCOME Y&lt;/text&gt;&lt;text x=&quot;774&quot; y=&quot;619&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Verified Answer&lt;/text&gt;&lt;!-- Z -&gt; Y Direct Confounding Edge --&gt;&lt;line x1=&quot;714&quot; y1=&quot;490&quot; x2=&quot;760&quot; y2=&quot;574&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.6&quot;/&gt;&lt;polygon points=&quot;753,572 763,580 763,567&quot; fill=&quot;#D97706&quot;/&gt;&lt;!-- Z -&gt; X Backdoor Edge (Active on Left, Severed by do(X) Surgery on Right!) --&gt;&lt;line x1=&quot;638&quot; y1=&quot;490&quot; x2=&quot;592&quot; y2=&quot;574&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;2.6&quot; stroke-dasharray=&quot;5 5&quot;/&gt;&lt;rect x=&quot;564&quot; y=&quot;518&quot; width=&quot;102&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;615&quot; y=&quot;532.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;✂ SEVERED!&lt;/text&gt;&lt;!-- True Causal Edge X -&gt; Y --&gt;&lt;line x1=&quot;654&quot; y1=&quot;608&quot; x2=&quot;692&quot; y2=&quot;608&quot; stroke=&quot;#059669&quot; stroke-width=&quot;3.4&quot;/&gt;&lt;polygon points=&quot;688,602 700,608 688,614&quot; fill=&quot;#059669&quot;/&gt;&lt;!-- Equation Box --&gt;&lt;rect x=&quot;504&quot; y=&quot;662&quot; width=&quot;344&quot; height=&quot;72&quot; rx=&quot;12&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;686&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;True Causal ATE = +24.6% (&quot;Tools Help!&quot;)&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;706&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;800&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Randomize A/B flag or stratify on difficulty Z&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;722&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;to sever backdoor Z → X path cleanly.&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T175" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #86 (T175) • LINKEDIN CAUSAL ML &amp; ECON HIT • STRUCTURAL CAUSAL DAG&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Causal AI Eval: &lt;span style='color:#2563EB;'&gt;do(X) C.A.U.S.A.L. DAG&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stop confusing observational log correlation with true intervention — sever confounders via &lt;b&gt;C.A.U.S.A.L.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T175" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;Online A/B + DoWhy&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T175" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ HOSPITALS HAVE MORE SICK PEOPLE:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Concluding hospitals cause illness from unadjusted raw logs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T175" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ DO(X) BACKDOOR ADJUSTMENT:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Sever Z → X via randomized A/B or stratified difficulty Z&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="cs_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;REVERSAL PARADOX IN LOGS&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Confounded Production&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Correlating Longer Reasoning Traces With Lower Accuracy&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Offline logs make extra thinking look harmful because &lt;b&gt;only baffling queries trigger 8-step reasoning&lt;/b&gt; (&lt;b&gt;Z → X&lt;/b&gt;).&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;Reversed Sign Error!&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="cs_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;DO-CALCULUS GRAPH SURGERY&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Causal Do-Calculus&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Sever Backdoor Paths via Randomized Flag or Z-Adjustment&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Draw the &lt;b&gt;Structural Causal DAG&lt;/b&gt; first: block every confounder &lt;b&gt;Z&lt;/b&gt; via online A/B randomization or backdoor adjustment.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;Unbiased True Causal Lift&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="cs_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: C · A · U · S · A · L&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Causal Inference&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Chart Confounders (Z) • Avoid Collider Bias • Unlink Z→X via do(X) • Stratify Difficulty Z • Assign Randomized A/B • Log Sensitivity Bounds&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Never turn off an agent guardrail or reasoning step from &lt;b&gt;raw observational correlation&lt;/b&gt; without checking &lt;b&gt;Z&lt;/b&gt; difficulty!&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T175" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#2563EB;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Longer reasoning looks negatively correlated with success in raw logs due to query-difficulty confounding; &lt;b&gt;do(X) randomization&lt;/b&gt; proves +24.6% true lift.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T175" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Vertex Experiments + BigQuery Stratified Eval&lt;/b&gt; ⇄ DoWhy / EconML + Double-ML&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T175" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Reversed a flawed feature-kill decision by exposing &lt;b&gt;difficulty confounding&lt;/b&gt; in agent logs&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

