ight=&quot;900&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;$0.003 • Ship Day 1&lt;/text&gt;&lt;rect x=&quot;244&quot; y=&quot;652&quot; width=&quot;184&quot; height=&quot;106&quot; rx=&quot;14&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;256&quot; y=&quot;662&quot; width=&quot;160&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#D97706&quot;/&gt;&lt;text x=&quot;336&quot; y=&quot;675.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;PATH 2 • STYLE / SPEED&lt;/text&gt;&lt;text x=&quot;336&quot; y=&quot;701&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Distilled LoRA / SFT&lt;/text&gt;&lt;text x=&quot;336&quot; y=&quot;719&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Teach behavior, NOT facts&lt;/text&gt;&lt;text x=&quot;336&quot; y=&quot;742&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#D97706&quot; text-anchor=&quot;middle&quot;&gt;8B/Flash • 180ms P95&lt;/text&gt;&lt;rect x=&quot;492&quot; y=&quot;652&quot; width=&quot;184&quot; height=&quot;106&quot; rx=&quot;14&quot; fill=&quot;#F0FDFA&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;504&quot; y=&quot;662&quot; width=&quot;160&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#0D9488&quot;/&gt;&lt;text x=&quot;584&quot; y=&quot;675.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;PATH 3 • READ-ONLY QA&lt;/text&gt;&lt;text x=&quot;584&quot; y=&quot;701&quot; font-family