598 495,598&quot; fill=&quot;#289448&quot;/&gt;&lt;!-- Merge from Direct Execution &amp; Invoke Tools into Execute Task --&gt;&lt;path d=&quot;M256 576 L256 662 Q256 670 264 670 L374.5 670 Q382.5 670 382.5 678 L382.5 692&quot; stroke=&quot;#1E293B&quot; stroke-width=&quot;1.8&quot; fill=&quot;none&quot;/&gt;&lt;path d=&quot;M491 660 L491 665 Q491 670 483 670 L390.5 670 Q382.5 670 382.5 678&quot; stroke=&quot;#1E293B&quot; stroke-width=&quot;1.8&quot; fill=&quot;none&quot;/&gt;&lt;polygon points=&quot;382.5,696 378.5,688 386.5,688&quot; fill=&quot;#1E293B&quot;/&gt;&lt;!-- Connectors in Band 03 --&gt;&lt;line x1=&quot;382.5&quot; y1=&quot;746&quot; x2=&quot;382.5&quot; y2=&quot;768&quot; stroke=&quot;#1E293B&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;polygon points=&quot;382.5,772 378.5,764 386.5,764&quot; fill=&quot;#1E293B&quot;/&gt;&lt;!-- NO branch to Self-Correction Loop --&gt;&lt;line x1=&quot;318&quot; y1=&quot;796&quot; x2=&quot;260&quot; y2=&quot;796&quot; stroke=&quot;#E05A2B&quot; stroke-width=&quot;2&quot;/&gt;&lt;polygon points=&quot;256,796 264,792 264,800&quot; fill=&quot;#E05A2B&quot;/&gt;&lt;!-- Orange arrow between Self-Correction Loop and Error Escalation --&gt;&lt;line x1=&quot;180&quot; y1=&quot;844&quot; x2=&quot;180&quot; y2=&quot;828&quot; stroke=&quot;#E05A2B&quot; stroke-width=&quot;2&quot;/&gt;&lt;polygon points=&quot;180,824 176,832 184,832&quot; fill=&quot;#E05A2B&quot;/&gt;&lt;!-- Loop back from left of Error Escalation to Execute Task --&gt;&lt;path d=&quot;M104 865 L94 865 Q88 865 88 857 L88 726 Q88 718 96 718 L305 718&quot; stroke=&quot;#1E293B&quot; stroke-width=&quot;1.8&quot; fill=&quot;none&quot;/&gt;&lt;polygon points=&quot;310,718 302,714 302,722&quot; fill=&quot;#1E293B&quot;/&gt;&lt;!-- YES branch to Deliver Final Result --&gt;&lt;line x1=&quot;382.5&quot; y1=&quot;820&quot; x2=&quot;382.5&quot; y2=&quot;866&quot; stroke=&quot;#289448&quot; stroke-width=&quot;2&quot;/&gt;&lt;polygon points=&quot;382.5,870 378.5,862 386.5,862&q