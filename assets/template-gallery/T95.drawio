    <mxCell id="hdr_T95" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#ECFDF5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T95) • ARCHIMEDES FULCRUM LEVERAGE • ZERO-BLOAT MCP + OBO&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Zero-Bloat MCP: &lt;span style='color:#059669;'&gt;40× Fulcrum Leverage&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Replace 55k static schema deadweight with lazy Top-4 tool search + RFC 8693 OBO (&lt;b&gt;S.C.O.P.E.&lt;/b&gt;)&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

