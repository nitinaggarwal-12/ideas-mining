        <mxCell id="L56_1" value="&lt;div style=&quot;width:302px;box-sizing:border-box;padding:9px 12px;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;&quot;&gt;&lt;div&gt;&lt;div style=&quot;font-size:15px;font-weight:800;color:#0F172A;line-height:1.15;&quot;&gt;02 Local Execution&lt;/div&gt;&lt;div style=&quot;display:inline-block;background:#0D152C;color:#FFFFFF;padding:2px 8px;border-radius:999px;font-size:9.2px;font-weight:800;margin-top:4px;letter-spacing:0.2px;&quot;&gt;UNSANDBOXED&lt;/div&gt;&lt;/div&gt;&lt;svg width=&quot;50&quot; height=&quot;22&quot; viewBox=&quot;0 0 50 22&quot; style=&quot;flex-shrink:0;&quot;&gt;&lt;rect x=&quot;0&quot; y=&quot;0&quot; width=&quot;50&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#9CA3AF&quot;/&gt;&lt;circle cx=&quot;11&quot; cy=&quot;11&quot; r=&quot;8.5&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;text x=&quot;34&quot; y=&quot;14.5&quot; text-anchor=&quot;middle&quot; fill=&quot;#FFFFFF&quot; font-family=&quot;Inter,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;800&quot;&gt;OFF&lt;/text&gt;&lt;/svg&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#1E293B;margin-top:6px;line-height:1.26;&quot;&gt;Executing code from tool outputs runs directly on your host environment, risking security exposure.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F6F6F4;strokeColor=#64748B;strokeWidth=1.4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="425" width="306" height="106" as="geometry"/></mxCell>
