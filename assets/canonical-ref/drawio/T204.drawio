nchor=&quot;middle&quot;&gt;Pure Visual Perception — Zero fragile XPath/CSS selectors!&lt;/text&gt;&lt;!-- Right: 4-Step Computer Use Perception-Action Loop --&gt;&lt;rect x=&quot;558&quot; y=&quot;376&quot; width=&quot;294&quot; height=&quot;320&quot; rx=&quot;14&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;705&quot; y=&quot;402&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;GEMINI COMPUTER USE LOOP&lt;/text&gt;&lt;rect x=&quot;578&quot; y=&quot;420&quot; width=&quot;254&quot; height=&quot;52&quot; rx=&quot;10&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;705&quot; y=&quot;441&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;1. Capture Normalized Screenshot&lt;/text&gt;&lt;text x=&quot;705&quot; y=&quot;459&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;0..1000 normalized screen grid&lt;/text&gt;&lt;rect x=&quot;578&quot; y=&quot;484&quot; width=&quot;254&quot; height=&quot;52&quot; rx=&quot;10&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;705&quot; y=&quot;505&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;2. Emit Typed GUI Action&lt;/text&gt;&lt;text x=&quot;705&quot; y=&quot;523&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#7C3AED&quot; text-anchor=&quot;middle&quot;&gt;click_at • type_text • scroll&lt;/text&gt;&lt;rect x=&quot;578&quot; y=&quot;548&quot; width=&quot;254&quot; height=&quot;52&quot; rx=&quot;10&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;text x=&quot;705&quot; y=&quot;569&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;3. Safety &amp;amp; HITL Gate&lt;/text&gt;&lt;text x=&quot;705&quot; y=&quot;587&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;Pause before payments / deletes&lt;/text&gt;&lt;rect x=&quot;578&quot; y=&quot;612&quot; width=&quot;254&quot; height=&quot;58&quot; rx=&quot;10&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;text x=&quot;705&quot; y=&quot;633&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;4. Visual State Verification&lt;/text&gt;&lt;text x=&quot;705&quot; y=&quot;651&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;Confirm toast/row updated ✓&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;738&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;COMPUTER USE RULE: Operate legacy UIs via normalized screenshots + mandatory HITL write gates!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

