    <mxCell id="hdr_T102" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T102) • GRAVITY-TURN ORBITAL ARC • SUB-300MS LIVE AUDIO&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Live Voice Agents: &lt;span style='color:#2563EB;'&gt;265ms O.R.B.I.T. Launch&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Chained STT → HTTP LLM → TTS drags at 3.4s — shed latency boosters via &lt;b&gt;O.R.B.I.T.&lt;/b&gt; native WebRTC&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

