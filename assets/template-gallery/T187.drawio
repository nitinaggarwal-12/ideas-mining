x=&quot;460&quot; y=&quot;381&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;TRL 4–6 TRANSLATION TRUSS:&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;397&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;1. Distill Argon→Flash  2. Dirty-Trace CI&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;411&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;3. OBO + Circuit-Breaker Harness&lt;/text&gt;&lt;line x1=&quot;68&quot; y1=&quot;696&quot; x2=&quot;852&quot; y2=&quot;696&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;732&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;RESEARCH ENGINEER MOAT: Owning TRL 4–6 translation makes you irreplaceable in every AI lab!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T187" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEF3C7;color:#92400E;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #98 (T187) • LINKEDIN APPLIED SCIENTIST &amp; R&amp;D LEAD HIT • TRL 1–9 BRIDGE&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Lab to Prod: &lt;span style='color:#D97706;'&gt;TRL 1→9 B.R.I.D.G.E.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Cross the &lt;b&gt;TRL 4–6&lt;/b&gt; Valley of Death where 88% of ML papers stall using the &lt;b&gt;B.R.I.D.G.E.&lt;/b&gt; truss&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

