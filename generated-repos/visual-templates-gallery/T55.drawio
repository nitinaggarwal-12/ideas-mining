        <mxCell id="s54_1" value="&lt;div style='width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;'&gt;&lt;div style='display:flex;align-items:center;'&gt;&lt;span style='background:#DCEBFF;color:#2563EB;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;'&gt;01&lt;/span&gt;&lt;b style='font-size:15px;color:#0F172A;'&gt;Open Agent Studio&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;'&gt;Choose Vision-Action Model in a desktop task, if available.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
