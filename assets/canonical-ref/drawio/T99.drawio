etry"/></mxCell>

    <mxCell id="an_bad_T99" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ RE-TYPING ENCYCLOPEDIAS:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Paying full price to &lt;b&gt;re-read the same 60-page manual&lt;/b&gt; on every chat message&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T99" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ D.R.O.P.S. BRIDGE:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Pinned KV prefix + lazy tools + Flash cascade&lt;/b&gt; = 16× more users on same GPU budget&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="hero_99" value="&lt;div style='width:488px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #A7F3D0;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;-93.7% TOTAL COST BRIDGE&lt;/span&gt;&lt;span style='background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Same 95.1% Task Quality&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Every Step Is Orthogonal &amp;amp; Measurable in CFO Dollars&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Pin static rules first (&lt;b&gt;-$0.195&lt;/b&gt;), fetch tools lazily (&lt;b&gt;-$0.130&lt;/b&gt;), route routine turns to Flash (&lt;b&gt;-$0.085&lt;/b&gt;) &amp;amp; trim JSON outputs (&lt;b&gt;-$0.040&lt;/b&gt;).&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="376" y="214" width="492" height="100" as="geometry"/></mxCell>
<mxCell id="b1_99" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#0D9488;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;STEPS D + R (-68%)&lt;/span&gt;&lt;span style='background:#CCFBF1;color:#115E59;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Zero Model Downgrade&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Freeze Prefix Order + Lazy Tool Search&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Never inject dynamic timestamps at byte 0; keep system + core skills 100% KV-cached across turns.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#0D9488;margin-top:4px;line-height:1.05;'&gt;91% Prefix Cache Hit Rate&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="816" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="b2_99" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;STEPS O + P + S (-25.7%)&lt;/span&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Mnemonic: D · R · O · P · S&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Tiered Flash Cascade + JQ Output Projection&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Strip 40KB REST payloads down to the 6 fields the LLM actually reasons over before appending history.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;$0.480 → $0.030 / turn&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="474" y="816" width="404" height="120" as="geometry"/></mxCell>

    <mxCell id="c1_T99" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Order prompts &lt;b&gt;static-to-dynamic&lt;/b&gt; for 90%+ KV-cache hits, retrieve tools lazily &amp;amp; project slim JSON tool outputs.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

