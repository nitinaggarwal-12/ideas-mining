<mxfile host="embed.diagrams.net" modified="2026-11-02T06:10:00.000Z" agent="PromptCanvas-Minter"><diagram id="T161" name="3-State Circuit-Breaker Finite State Machine for LLM Resilience"><mxGraphModel dx="920" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1150" background="#FAF8F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="bg_T161" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT161&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT161&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT161)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT161&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT161)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;!-- Curved FSM Transition Arcs --&gt;&lt;!-- 1. CLOSED -&gt; OPEN (Top Crimson Trip Arc) --&gt;&lt;path d=&quot;M 272 446 Q 460 356 648 446&quot; fill=&quot;none&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;3.8&quot;/&gt;&lt;polygon points=&quot;642,437 654,449 638,450&quot; fill=&quot;#DC2626&quot;/&gt;&lt;rect x=&quot;330&quot; y=&quot;362&quot; width=&quot;260&quot; height=&quot;28&quot; rx=&quot;14&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;380&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;TRIP: ≥5 HTTP 429/503 or P95 &amp;gt; 6s&lt;/text&gt;&lt;!-- 2. OPEN -&gt; HALF-OPEN (Right Amber Cooldown Arc) --&gt;&lt;path d=&quot;M 702 574 Q 656 666 550 684&quot; fill=&quot;none&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;3.4&quot;/&gt;&lt;polygon points=&quot;558,677 544,685 559,690&quot; fill=&quot;#D97706&quot;/&gt;&lt;rect x=&quot;598&quot; y=&quot;636&quot; width=&quot;232&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;714&quot; y=&quot;653&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;30s Cooldown Timer Expires →&lt;/text&gt;&lt;!-- 3. HALF-OPEN -&gt; CLOSED (Left Emerald Recovery Arc) --&gt;&lt;path d=&quot;M 370 684 Q 264 666 218 574&quot; fill=&quot;none&quot; stroke=&quot;#059669&quot; stroke-width=&quot;3.6&quot;/&gt;&lt;polygon points=&quot;214,585 216,569 227,580&quot; fill=&quot;#059669&quot;/&gt;&lt;rect x=&quot;86&quot; y=&quot;636&quot; width=&quot;236&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;204&quot; y=&quot;653&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;✓ 3/3 Canary Probes Pass →&lt;/text&gt;&lt;!-- 4. HALF-OPEN -&gt; OPEN (Inner Dashed Re-Trip Arc) --&gt;&lt;path d=&quot;M 534 654 Q 596 598 656 540&quot; fill=&quot;none&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;2.4&quot; stroke-dasharray=&quot;6 4&quot;/&gt;&lt;polygon points=&quot;648,538 662,535 656,548&quot; fill=&quot;#EF4444&quot;/&gt;&lt;rect x=&quot;514&quot; y=&quot;576&quot; width=&quot;144&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;text x=&quot;586&quot; y=&quot;590.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;1 Probe Fails → Re-Open&lt;/text&gt;&lt;g filter=&quot;url(#softDropT161)&quot;&gt;&lt;!-- STATE 1: CLOSED (Left Emerald Circle cx=196, cy=496, r=86) --&gt;&lt;circle cx=&quot;196&quot; cy=&quot;496&quot; r=&quot;86&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;4&quot;/&gt;&lt;rect x=&quot;136&quot; y=&quot;438&quot; width=&quot;120&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;196&quot; y=&quot;451.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;1. CLOSED (NORMAL)&lt;/text&gt;&lt;text x=&quot;196&quot; y=&quot;482&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12.5&quot; font-weight=&quot;900&quot; fill=&quot;#064E3B&quot; text-anchor=&quot;middle&quot;&gt;Primary Frontier&lt;/text&gt;&lt;text x=&quot;196&quot; y=&quot;500&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;Gemini 4 Argon&lt;/text&gt;&lt;text x=&quot;196&quot; y=&quot;520&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;100% live traffic&lt;/text&gt;&lt;text x=&quot;196&quot; y=&quot;536&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;Rolling 10s window&lt;/text&gt;&lt;!-- STATE 2: OPEN (Right Crimson Circle cx=724, cy=496, r=86) --&gt;&lt;circle cx=&quot;724&quot; cy=&quot;496&quot; r=&quot;86&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;4&quot;/&gt;&lt;rect x=&quot;660&quot; y=&quot;438&quot; width=&quot;128&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#DC2626&quot;/&gt;&lt;text x=&quot;724&quot; y=&quot;451.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;2. OPEN (TRIPPED!)&lt;/text&gt;&lt;text x=&quot;724&quot; y=&quot;482&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12.5&quot; font-weight=&quot;900&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;middle&quot;&gt;0ms Fast-Failover&lt;/text&gt;&lt;text x=&quot;724&quot; y=&quot;500&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;→ Flash + Cache Tier&lt;/text&gt;&lt;text x=&quot;724&quot; y=&quot;520&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Zero hanging sockets&lt;/text&gt;&lt;text x=&quot;724&quot; y=&quot;536&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;Stops retry storm!&lt;/text&gt;&lt;!-- STATE 3: HALF-OPEN (Bottom Amber Circle cx=460, cy=684, r=78) --&gt;&lt;circle cx=&quot;460&quot; cy=&quot;684&quot; r=&quot;78&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;4&quot;/&gt;&lt;rect x=&quot;394&quot; y=&quot;632&quot; width=&quot;132&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#D97706&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;645.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;3. HALF-OPEN (PROBE)&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;674&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#78350F&quot; text-anchor=&quot;middle&quot;&gt;1% Canary Test&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;693&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;Allow 3 Probe Calls&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;712&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Verify health safely&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T161" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEF3C7;color:#92400E;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #72 (T161) • LINKEDIN DISTRIBUTED SYSTEMS CLASSIC • CIRCUIT-BREAKER FSM&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;LLM Resilience: &lt;span style='color:#D97706;'&gt;Circuit S.T.A.T.E. FSM&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Survive regional quota spikes &amp;amp; 503s with zero user downtime via a 3-state &lt;b&gt;S.T.A.T.E.&lt;/b&gt; circuit breaker&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T161" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#D97706&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#D97706&quot; text-anchor=&quot;middle&quot;&gt;Global Endpoint + FSM&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T161" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ BLIND 3× RETRY LOOPS:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Hammering a rate-limited endpoint until your own pods OOM&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T161" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ CLOSED ⇄ OPEN ⇄ HALF-OPEN:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Trip fast → route to Flash/Cache → probe 3 calls → auto-close&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="cb_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;THUNDERING-HERD RETRY STORM&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Thread-Pool Exhaustion&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Naive Exponential Retries Amplify Regional 429s Into Total Outage&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;When an LLM endpoint degrades, 5,000 workers waiting 30s × 3 retries &lt;b&gt;starve every connection pool&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;90s User Hang → Crash&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="cb_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;3-STATE CIRCUIT BREAKER&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Sub-Second Graceful Degrade&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Trip Open in 200ms &amp;amp; Degrade Gracefully to Flash + Cache&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Shed load off the struggling tier immediately, serve degraded-mode Flash answers, and &lt;b&gt;self-heal via Half-Open probes&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;99.98% Perceived Uptime&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="cb_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: S · T · A · T · E&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEF3C7;color:#92400E;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Resilience Engineering&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Sliding 10s Window • Trip on 5× 429/503 • Activate Flash Fallback • Test 3 Half-Open Probes • Engage Closed Primary Automatically&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Wrap every external &lt;b&gt;LLM endpoint and 3P MCP server&lt;/b&gt; in its own isolated circuit-breaker state machine.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T161" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#D97706;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Never rely on retries alone: wrap each model and MCP upstream in a &lt;b&gt;3-state circuit breaker&lt;/b&gt; that fails over to KV-cached Flash in &amp;lt;200ms.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

