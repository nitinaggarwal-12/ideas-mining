    <mxCell id="core_t92" value="&lt;div style='width:104px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:center;color:#FFFFFF;'&gt;&lt;div style='font-size:16px;font-weight:900;letter-spacing:0.6px;color:#6EE7B7;'&gt;V·A·U·L·T&lt;/div&gt;&lt;div style='font-size:11px;font-weight:800;color:#FFFFFF;margin-top:2px;'&gt;R1 KERNEL&lt;/div&gt;&lt;div style='font-size:9.5px;color:#A7F3D0;'&gt;0 Host Escapes&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="408" y="528" width="104" height="60" as="geometry"/></mxCell>
<mxCell id="q1_t92" value="&lt;div style='width:234px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#334155;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;RING 4 • V&lt;/span&gt;&lt;span style='background:#F1F5F9;color:#0F172A;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;99.4% Blocked&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Vet Untrusted Inputs&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Model Armor scrubs indirect prompt injections before agent parses.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#334155;margin-top:4px;line-height:1.05;'&gt;&lt;12ms Edge Scrub&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="214" width="238" height="120" as="geometry"/></mxCell>
<mxCell id="q2_t92" value="&lt;div style='width:234px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;RING 3 • A&lt;/span&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Zero Static Keys&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Attenuate OBO Scopes&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Mint 5-min read-only JWTs per turn; strip broad service-account keys.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;5-Min TTL Token&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="648" y="214" width="238" height="120" as="geometry"/></mxCell>
<mxCell id="q3_t92" value="&lt;div style='width:234px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#0D9488;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;RING 2 • L&lt;/span&gt;&lt;span style='background:#CCFBF1;color:#115E59;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Deny-By-Default&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Lock Network Egress&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;mTLS proxy blocks raw IPs, webhook pastebins &amp;amp; DNS tunneling.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#0D9488;margin-top:4px;line-height:1.05;'&gt;0 Exfiltrated Bytes&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="748" width="238" height="120" as="geometry"/></mxCell>
<mxCell id="q4_t92" value="&lt;div style='width:234px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#047857;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;RING 1 • U + T&lt;/span&gt;&lt;span style='background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Ephemeral VM&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Unshare gVisor + Tear Down&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Run tool/Python code in user-space syscall jail &amp;amp; wipe FS on exit.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;0 Kernel Escapes&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="648" y="748" width="238" height="120" as="geometry"/></mxCell>
