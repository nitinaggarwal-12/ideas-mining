    <mxCell id="an_bad_T127" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ HONOR-SYSTEM HOTEL:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Telling the concierge &lt;b&gt;&amp;ldquo;please only read Room 402&amp;rsquo;s mail&amp;rdquo;&lt;/b&gt; from 1 pile&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

