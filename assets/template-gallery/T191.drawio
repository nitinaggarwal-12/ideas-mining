ies[] + URIs[]&lt;/text&gt;&lt;text x=&quot;734&quot; y=&quot;590&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Span-to-URL confidence scores&lt;/text&gt;&lt;text x=&quot;734&quot; y=&quot;610&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;700&quot; fill=&quot;#0369A1&quot; text-anchor=&quot;middle&quot;&gt;1 API round-trip instead of 2!&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;738&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;GEMINI 3.8+ BREAKTHROUGH: Combine Google Search / URL Context + response_schema in 1 atomic call!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

