    <!-- Precision Vector Grid Paper + 4-Color Torus Ring + Curved Flow Arrows -->
    <mxCell id="poster_bg" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;765&quot; height=&quot;1024&quot; viewBox=&quot;0 0 765 1024&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGrid66&quot; width=&quot;19.125&quot; height=&quot;19.125&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 19.125 0 L 0 0 0 19.125&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.7&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGrid66&quot; width=&quot;76.5&quot; height=&quot;76.5&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;76.5&quot; height=&quot;76.5&quot; fill=&quot;url(#minorGrid66)&quot;/&gt;&lt;path d=&quot;M 76.5 0 L 0 0 0 76.5&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.1&quot;/&gt;&lt;/pattern&gt;&lt;linearGradient id=&quot;torusTopLeft&quot; gradientUnits=&quot;userSpaceOnUse&quot; x1=&quot;170&quot; y1=&quot;442&quot; x2=&quot;382&quot; y2=&quot;229&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#D2EBD9&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#C3E7D4&quot;/&gt;&lt;/linearGradient&gt;&lt;linearGradient id=&quot;torusTopRight&quot; gradientUnits=&quot;userSpaceOnUse&quot; x1=&quot;382&quot; y1=&quot;229&quot; x2=&quot;595&quot; y2=&quot;442&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#C3E7D4&quot;/&gt;&lt;stop offset=&quot;50%&quot; stop-color=&quot;#C1DBF7&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#CEE0F6&quot;/&gt;&lt;/linearGradient&gt;&lt;linearGradient id=&quot;torusBotRight&quot; gradientUnits=&quot;userSpaceOnUse&quot; x1=&quot;595&quot; y1=&quot;442&quot; x2=&quot;382&quot; y2=&quot;655&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#CEE0F6&quot;/&gt;&lt;stop offset=&quot;45%&quot; stop-color=&quot;#D5EBD4&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#F6D5C2&quot;/&gt;&lt;/linearGradient&gt;&lt;linearGradient id=&quot;torusBotLeft&quot; gradientUnits=&quot;userSpaceOnUse&quot; x1=&quot;382&quot; y1=&quot;655&quot; x2=&quot;170&quot; y2=&quot;442&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#F9CCBA&quot;/&gt;&lt;stop offset=&quot;45%&quot; stop-color=&quot;#FAD2C0&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#D2EBD9&quot;/&gt;&lt;/linearGradient&gt;&lt;filter id=&quot;ringShadow66&quot; x=&quot;-8%&quot; y=&quot;-8%&quot; width=&quot;116%&quot; height=&quot;116%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;4&quot; stdDeviation=&quot;6&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.10&quot;/&gt;&lt;/filter&gt;&lt;path id=&quot;arcOrchestrate66&quot; d=&quot;M 308 205 A 242 242 0 0 1 458 205&quot;/&gt;&lt;path id=&quot;arcExecute66&quot; d=&quot;M 530 296 A 204 204 0 0 1 574 378&quot;/&gt;&lt;path id=&quot;arcRetryText66&quot; d=&quot;M 152 536 A 232 232 0 0 1 156 346&quot;/&gt;&lt;/defs&gt;&lt;!-- Base Cream Grid Paper --&gt;&lt;rect width=&quot;765&quot; height=&quot;1024&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;765&quot; height=&quot;1024&quot; fill=&quot;url(#majorGrid66)&quot;/&gt;&lt;!-- Soft Top &amp; Bottom Readability Vignette --&gt;&lt;rect x=&quot;20&quot; y=&quot;14&quot; width=&quot;725&quot; height=&quot;105&quot; rx=&quot;16&quot; fill=&quot;#FAF8F2&quot; fill-opacity=&quot;0.68&quot;/&gt;&lt;rect x=&quot;20&quot; y=&quot;795&quot; width=&quot;725&quot; height=&quot;175&quot; rx=&quot;16&quot; fill=&quot;#FAF8F2&quot; fill-opacity=&quot;0.72&quot;/&gt;&lt;!-- 4-Quadrant Smooth Torus Ring (cx=382.5, cy=442, R_out=292, R_in=134, R_mid=213, strokeWidth=158) --&gt;&lt;g filter=&quot;url(#ringShadow66)&quot;&gt;&lt;!-- Top-Left Quadrant (180 deg to 270 deg) --&gt;&lt;path d=&quot;M 169.5 442 A 213 213 0 0 1 382.5 229&quot; fill=&quot;none&quot; stroke=&quot;url(#torusTopLeft)&quot; stroke-width=&quot;158&quot;/&gt;&lt;!-- Top-Right Quadrant (270 deg to 360 deg) --&gt;&lt;path d=&quot;M 382.5 229 A 213 213 0 0 1 595.5 442&quot; fill=&quot;none&quot; stroke=&quot;url(#torusTopRight)&quot; stroke-width=&quot;158&quot;/&gt;&lt;!-- Bottom-Right Quadrant (0 deg to 90 deg) --&gt;&lt;path d=&quot;M 595.5 442 A 213 213 0 0 1 382.5 655&quot; fill=&quot;none&quot; stroke=&quot;url(#torusBotRight)&quot; stroke-width=&quot;158&quot;/&gt;&lt;!-- Bottom-Left Quadrant (90 deg to 180 deg) --&gt;&lt;path d=&quot;M 382.5 655 A 213 213 0 0 1 169.5 442&quot; fill=&quot;none&quot; stroke=&quot;url(#torusBotLeft)&quot; stroke-width=&quot;158&quot;/&gt;&lt;/g&gt;&lt;!-- Outer &amp; Inner Torus Borders --&gt;&lt;circle cx=&quot;382.5&quot; cy=&quot;442&quot; r=&quot;292&quot; fill=&quot;none&quot; stroke=&quot;#8FA1B5&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;circle cx=&quot;382.5&quot; cy=&quot;442&quot; r=&quot;134&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#8FA1B5&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;!-- 1. TOP ARC ARROW: Orchestrate --&gt;&lt;path d=&quot;M 311 222 A 232 232 0 0 1 445 220&quot; fill=&quot;none&quot; stroke=&quot;#162B4C&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;456,223 440,211 443,228&quot; fill=&quot;#162B4C&quot;/&gt;&lt;text font-family=&quot;Inter, -apple-system, sans-serif&quot; font-size=&quot;15.5&quot; font-weight=&quot;600&quot; fill=&quot;#0F2143&quot; text-anchor=&quot;middle&quot;&gt;&lt;textPath href=&quot;#arcOrchestrate66&quot; startOffset=&quot;50%&quot;&gt;Orchestrate&lt;/textPath&gt;&lt;/text&gt;&lt;!-- 2. RIGHT UPPER ARC ARROW: Execute --&gt;&lt;path d=&quot;M 559 286 A 226 226 0 0 1 601 371&quot; fill=&quot;none&quot; stroke=&quot;#3572E2&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;606,382 592,369 608,363&quot; fill=&quot;#3572E2&quot;/&gt;&lt;text font-family=&quot;Inter, -apple-system, sans-serif&quot; font-size=&quot;15.5&quot; font-weight=&quot;600&quot; fill=&quot;#0F2143&quot; text-anchor=&quot;middle&quot;&gt;&lt;textPath href=&quot;#arcExecute66&quot; startOffset=&quot;46%&quot;&gt;Execute&lt;/textPath&gt;&lt;/text&gt;&lt;!-- 3. BOTTOM-RIGHT BIFURCATING GREEN ARROWS: PASS --&gt;&lt;path d=&quot;M 577 553 Q 545 604 494 636&quot; fill=&quot;none&quot; stroke=&quot;#329E4B&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;483,642 494,626 502,640&quot; fill=&quot;#329E4B&quot;/&gt;&lt;path d=&quot;M 577 553 Q 556 624 612 648&quot; fill=&quot;none&quot; stroke=&quot;#329E4B&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;624,651 606,654 612,639&quot; fill=&quot;#329E4B&quot;/&gt;&lt;text x=&quot;515&quot; y=&quot;601&quot; font-family=&quot;Inter, -apple-system, sans-serif&quot; font-size=&quot;15&quot; font-weight=&quot;800&quot; fill=&quot;#0F2143&quot; text-anchor=&quot;middle&quot;&gt;PASS&lt;/text&gt;&lt;!-- 4. BOTTOM ARC ARROW: FAIL --&gt;&lt;path d=&quot;M 477 648 Q 392 686 308 654&quot; fill=&quot;none&quot; stroke=&quot;#D9483B&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;296,649 314,647 308,663&quot; fill=&quot;#D9483B&quot;/&gt;&lt;text x=&quot;392&quot; y=&quot;655&quot; font-family=&quot;Inter, -apple-system, sans-serif&quot; font-size=&quot;15&quot; font-weight=&quot;800&quot; fill=&quot;#0F2143&quot; text-anchor=&quot;middle&quot;&gt;FAIL&lt;/text&gt;&lt;!-- 5. LEFT ARC ARROW: RETRY FEEDBACK PATH --&gt;&lt;path d=&quot;M 168 540 A 216 216 0 0 1 171 344&quot; fill=&quot;none&quot; stroke=&quot;#162B4C&quot; stroke-width=&quot;4&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;polygon points=&quot;175,333 162,346 178,351&quot; fill=&quot;#162B4C&quot;/&gt;&lt;text font-family=&quot;Inter, -apple-system, sans-serif&quot; font-size=&quot;13.5&quot; font-weight=&quot;800&quot; fill=&quot;#0F2143&quot; letter-spacing=&quot;0.4&quot; text-anchor=&quot;middle&quot;&gt;&lt;textPath href=&quot;#arcRetryText66&quot; startOffset=&quot;50%&quot;&gt;RETRY FEEDBACK PATH&lt;/textPath&gt;&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="765" height="1024" as="geometry"/></mxCell>

