      <mxCell id="env61" value="&lt;div style=&quot;position:relative;padding:12px 18px;text-align:center;font-family:Inter,sans-serif;color:#FFFFFF;width:649px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;font-size:16px;font-weight:900;letter-spacing:0.3px;&quot;&gt;UNIFIED RESOURCE &amp; ENVIRONMENT LAYER&lt;/div&gt;&lt;div style=&quot;position:absolute;right:8px;top:14px;background:#A5D8F3;color:#0F172A;width:29px;height:29px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;&quot;&gt;03&lt;/div&gt;&lt;div style=&quot;margin-top:6px;display:flex;justify-content:center;gap:8px;&quot;&gt;&lt;span style=&quot;background:#3898EC;color:#0F172A;padding:2px 9px;border-radius:8px;font-size:9.5px;font-weight:800;&quot;&gt;ISOLATED VPC&lt;/span&gt;&lt;span style=&quot;background:#149E94;color:#FFFFFF;padding:2px 9px;border-radius:8px;font-size:9.5px;font-weight:800;&quot;&gt;SECURE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#E2E8F0;margin-top:6px;&quot;&gt;Execution boundary for sandboxed workloads, database access, &amp; storage.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#162038;strokeColor=#0F172A;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="685" height="84" as="geometry"/></mxCell>

