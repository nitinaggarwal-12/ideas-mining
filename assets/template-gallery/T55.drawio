      <!-- Header -->
      <mxCell id="hdr54" value="&lt;div style='text-align:left;font-family:Inter,sans-serif;'&gt;&lt;div style='font-size:44px;font-weight:800;color:#0B1324;letter-spacing:-1px;line-height:1.1;'&gt;Autonomous Agent &lt;span style='color:#2D68FF;'&gt;Computer Use&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:18.5px;color:#475569;margin-top:8px;font-weight:500;'&gt;Set it up on your workstation, then copy four prompts that do real work.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="840" height="86" as="geometry"/></mxCell>

      <!-- LEFT COLUMN: Start using it (Steps 01 - 07) -->
      <mxCell id="col54_L" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="122" width="414" height="716" as="geometry"/></mxCell>
      <mxCell id="hdr54_L" value="Start using it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="38" y="138" width="320" height="32" as="geometry"/></mxCell>

      <mxCell id="s54_1" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#DCEBFF;color:#2563EB;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;01&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Open Agent Studio&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Choose Vision-Action Model in a desktop task, if available.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="178" width="378" height="64" as="geometry"/></mxCell>

      <mxCell id="s54_2" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#DCEBFF;color:#2563EB;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;02&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Install Computer Use&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Plugins → Computer Use; enable server and skill, then select Try now.&lt;/div&gt;&lt;div style=&quot;margin-left:34px;margin-top:9px;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;font-size:11.5px;font-weight:700;color:#334155;&quot;&gt;Server&lt;/span&gt;&lt;svg width=&quot;28&quot; height=&quot;16&quot; viewBox=&quot;0 0 28 16&quot; style=&quot;vertical-align:middle;margin:0 16px 0 8px;&quot;&gt;&lt;rect x=&quot;0&quot; y=&quot;0&quot; width=&quot;28&quot; height=&quot;16&quot; rx=&quot;8&quot; fill=&quot;#BAC6DD&quot;/&gt;&lt;circle cx=&quot;8&quot; cy=&quot;8&quot; r=&quot;5.5&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;/svg&gt;&lt;span style=&quot;font-size:11.5px;font-weight:700;color:#334155;&quot;&gt;Skill&lt;/span&gt;&lt;svg width=&quot;28&quot; height=&quot;16&quot; viewBox=&quot;0 0 28 16&quot; style=&quot;vertical-align:middle;margin:0 16px 0 8px;&quot;&gt;&lt;rect x=&quot;0&quot; y=&quot;0&quot; width=&quot;28&quot; height=&quot;16&quot; rx=&quot;8&quot; fill=&quot;#BAC6DD&quot;/&gt;&lt;circle cx=&quot;8&quot; cy=&quot;8&quot; r=&quot;5.5&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;/svg&gt;&lt;span style=&quot;background:#F7EEFF;color:#1E293B;padding:4px 28px 4px 12px;border-radius:6px;font-size:11.5px;font-weight:700;margin-left:8px;&quot;&gt;Try now&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="250" width="378" height="98" as="geometry"/></mxCell>

      <mxCell id="s54_3" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#DCEBFF;color:#2563EB;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;03&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Grant OS permissions&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Allow Screen Recording to see, and Accessibility to click and type.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="356" width="378" height="66" as="geometry"/></mxCell>

      <mxCell id="s54_4" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#DCEBFF;color:#2563EB;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;04&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Connect Browser&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Settings → Computer Use → Browser; install the extension and confirm Manage.&lt;/div&gt;&lt;div style=&quot;margin-left:34px;margin-top:8px;display:flex;align-items:center;gap:8px;&quot;&gt;&lt;span style=&quot;display:inline-block;width:215px;background:#EAF2FF;color:#1E293B;padding:5px 10px;border-radius:6px;font-size:11.5px;font-weight:700;&quot;&gt;Browser&lt;/span&gt;&lt;span style=&quot;display:inline-block;width:82px;background:#F7EEFF;color:#1E293B;padding:5px 10px;border-radius:6px;font-size:11.5px;font-weight:700;&quot;&gt;Manage&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="430" width="378" height="98" as="geometry"/></mxCell>

      <mxCell id="s54_5" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;05&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Point it at the work&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Mention @Browser or an app, then describe the result you want.&lt;/div&gt;&lt;div style=&quot;margin-left:34px;margin-top:8px;background:#F2F3F8;padding:7px 10px;border-radius:8px;font-size:12px;color:#334155;font-weight:600;&quot;&gt;&lt;span style=&quot;background:#EAE0FC;color:#1E293B;padding:3px 10px;border-radius:6px;font-weight:700;margin-right:8px;&quot;&gt;@Browser&lt;/span&gt;Compare these three suppliers.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="538" width="378" height="106" as="geometry"/></mxCell>

      <mxCell id="s54_6" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;border-bottom:1px solid #E2E8F0;padding-bottom:10px;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;06&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Approve access&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Allow the relevant app or website when prompted.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="652" width="378" height="64" as="geometry"/></mxCell>

      <mxCell id="s54_7" value="&lt;div style=&quot;width:378px;box-sizing:border-box;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;&quot;&gt;&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:3px 6px;border-radius:6px;font-weight:800;font-size:12.5px;margin-right:10px;&quot;&gt;07&lt;/span&gt;&lt;b style=&quot;font-size:15px;color:#0F172A;&quot;&gt;Sign in yourself&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-left:34px;margin-top:3px;line-height:1.35;&quot;&gt;Complete the login, let it continue, then inspect the result.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#64748B;margin-top:12px;&quot;&gt;Availability depends on rollout and workspace settings.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="38" y="724" width="378" height="96" as="geometry"/></mxCell>

      <!-- Bottom-Left: Try this prompt -->
      <mxCell id="try54_hdr" value="Try this prompt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontColor=#2D68FF;" vertex="1" parent="1"><mxGeometry x="34" y="852" width="240" height="24" as="geometry"/></mxCell>
      <mxCell id="try54_box" value="&lt;div style=&quot;padding:12px 48px 12px 16px;text-align:left;font-family:Inter,sans-serif;font-size:13px;color:#334155;line-height:1.4;&quot;&gt;Use [app or page] to achieve [result].&lt;br/&gt;Use an available plugin for the work it supports, then Computer Use for remaining steps and visual checks. Preserve [constraints], check against [success criteria], and show me the result.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="882" width="414" height="128" as="geometry"/></mxCell>
      <mxCell id="try54_btn" value="↑" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D68FF;strokeColor=#2D68FF;fontColor=#FFFFFF;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="392" y="972" width="30" height="30" as="geometry"/></mxCell>

      <!-- RIGHT COLUMN: Four jobs to start with -->
      <mxCell id="hdr54_R" value="&lt;div style=&quot;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;font-size:24px;font-weight:800;color:#0F172A;&quot;&gt;Four jobs to start with&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748B;margin-top:4px;&quot;&gt;Example apps; available plugins vary by workspace.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="452" y="122" width="418" height="54" as="geometry"/></mxCell>

      <mxCell id="ban54_R" value="&lt;div style=&quot;padding:12px 16px;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;font-size:14.5px;font-weight:800;color:#0F172A;&quot;&gt;Plugin → Computer Use → Check&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#64748B;margin-top:4px;line-height:1.35;&quot;&gt;Use a plugin where one exists, then Computer Use for the remaining steps and visual checks.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF4FF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="452" y="186" width="418" height="80" as="geometry"/></mxCell>

      <mxCell id="job54_1" value="&lt;div style=&quot;padding:14px 16px;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;font-size:15.5px;font-weight:800;color:#0F172A;&quot;&gt;&lt;svg width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 24 24&quot; style=&quot;vertical-align:middle;margin-right:6px;&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;10&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M12 2 A10 10 0 0 1 20.66 7 L12 7 Z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M3.34 7 A10 10 0 0 1 20.66 7 L15.5 15.5 L12 7 Z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M3.34 7 A10 10 0 0 0 12 22 L16.33 14.5 L8.5 14.5 Z&quot; fill=&quot;#34A853&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;4.6&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;3.6&quot; fill=&quot;#4285F4&quot;/&gt;&lt;/svg&gt;&lt;svg width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 24 24&quot; style=&quot;vertical-align:middle;margin-right:10px;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;22&quot; height=&quot;22&quot; rx=&quot;4&quot; fill=&quot;#13B5EA&quot;/&gt;&lt;text x=&quot;12&quot; y=&quot;14.5&quot; text-anchor=&quot;middle&quot; fill=&quot;#FFFFFF&quot; font-family=&quot;Inter,sans-serif&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot;&gt;ERP&lt;/text&gt;&lt;/svg&gt;&lt;span&gt;Accounts: match invoices&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#F1F3F8;padding:10px 12px;border-radius:8px;font-size:13px;color:#334155;margin-top:10px;line-height:1.4;&quot;&gt;@Browser Compare these invoices with my purchase-order list. Flag unmatched invoices, duplicate invoice numbers and total mismatches in a review table.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#64748B;margin-top:8px;&quot;&gt;Done when every invoice is matched or flagged for review.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="452" y="280" width="418" height="168" as="geometry"/></mxCell>

      <mxCell id="job54_2" value="&lt;div style=&quot;padding:14px 16px;text-align:left;font-family:Inter,sans-serif;&quot;&gt;&lt;div style=&quot;display:flex;align-items:center;font-size:15.5px;font-weight:800;color:#0F172A;&quot;&gt;&lt;svg width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 24 24&quot; style=&quot;vertical-align:middle;margin-right:6px;&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;10&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M12 2 A10 10 0 0 1 20.66 7 L12 7 Z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M3.34 7 A10 10 0 0 1 20.66 7 L15.5 15.5 L12 7 Z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M3.34 7 A10 10 0 0 0 12 22 L16.33 14.5 L8.5 14.5 Z&quot; fill=&quot;#34A853&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;4.6&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;3.6&quot; fill=&quot;#4285F4&quot;/&gt;&lt;/svg&gt;&lt;svg width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 24 24&quot; style=&quot;vertical-align:middle;margin-right:10px;&quot;&gt;&lt;path d=&quot;M2 6.5V18c0 1.1.9 2 2 2h2V9.8l6 4.5 6-4.5V20h2c1.1 0 2-.9 2-2V6.5c0-1.8-2.1-2.8-3.5-1.7L12 10 5.5 4.8C4.1 3.7 2 4.7 2 6.5z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M2 6.5V18c0 1.1.9 2 2 2h2V9.8L2 6.8z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M22 6.5V18c0 1.1-.9 2-2 2h-2V9.8l4-3z&quot; fill=&quot;#34A853&quot;/&gt;&lt;path d=&quot;M18 9.8V4.8L12 9.3 6 4.8v5l6 4.5z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M2 6.5c0-1.8 2.1-2.8 3.5-1.7L6 5.2v4.6L2 6.8z&quot; fill=&quot;#C5221F&quot;/&gt;&lt;path d=&quot;M22 6.5c0-1.8-2.1-2.8-3.5-1.7L18 5.2v4.6l4-3z&quot; fill=&quot;#FBBC04&quot;/&gt;&lt;/svg&gt;&lt;span&gt;Sales: draft follow-ups&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#F1F3F8;padding:10px 12px;border-radius:8px;font-size:13px;color:#334155;margin-top:10px;line-height:1.4;&quot;&gt;@Browser Open the five email threads I've tagged. Draft a follow-up for each in my usual tone, under 90 words. Leave them all unsent.&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#64748B;margin-top:8px;&quot;&gt;Done when five drafts sit unsent, each under 90 words.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="452" y="462" width="418" height="168" as="geometry"/></mxCell>

