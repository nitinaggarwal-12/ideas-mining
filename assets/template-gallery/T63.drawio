      <!-- Q1: 01 | QUICK WINS -->
      <mxCell id="q62_1" value="&lt;div style=&quot;padding:14px 15px;text-align:left;font-family:Inter,sans-serif;width:254px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;&quot;&gt;&lt;span style=&quot;font-size:18px;font-weight:900;color:#0F172A;&quot;&gt;01 | QUICK WINS&lt;/span&gt;&lt;span style=&quot;background:#568278;color:#FFFFFF;width:30px;height:30px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:15px;font-weight:900;&quot;&gt;✓&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#1E293B;margin-top:4px;line-height:1.25;&quot;&gt;High ROI, fast implementation.&lt;br/&gt;Build first.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:6px;&quot;&gt;&lt;div style=&quot;background:#1D6CE0;color:#FFF;padding:5px 8px;border-radius:999px;font-size:10.2px;font-weight:700;text-align:center;line-height:1.15;&quot;&gt;Draft Email&lt;br/&gt;Responses&lt;/div&gt;&lt;div style=&quot;background:#1E9E49;color:#FFF;padding:5px 8px;border-radius:999px;font-size:10.2px;font-weight:700;text-align:center;line-height:1.15;&quot;&gt;Document&lt;br/&gt;Translation&lt;/div&gt;&lt;div style=&quot;background:#0D8A7B;color:#FFF;padding:5px 8px;border-radius:999px;font-size:10.2px;font-weight:700;text-align:center;line-height:1.15;&quot;&gt;Meeting&lt;br/&gt;Summaries&lt;/div&gt;&lt;div style=&quot;background:#1D6CE0;color:#FFF;padding:5px 8px;border-radius:999px;font-size:10.2px;font-weight:700;text-align:center;line-height:1.15;&quot;&gt;Standard Ticket&lt;br/&gt;Routing&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#23B26D;color:#FFF;padding:5px 14px;border-radius:999px;font-size:10.5px;font-weight:700;&quot;&gt;Auto-tagging CRM Leads&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:12px;display:flex;gap:6px;&quot;&gt;&lt;span style=&