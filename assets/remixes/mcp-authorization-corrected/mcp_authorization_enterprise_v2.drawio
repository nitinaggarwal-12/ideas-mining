<mxfile host="app.diagrams.net" modified="2026-11-12T20:05:00.000Z" agent="IdeasMintingStudio" version="24.0.0">
  <diagram id="enterprise-mcp-auth-v2" name="Enterprise MCP Authorization (Corrected)">
    <mxGraphModel dx="1080" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr_bg" value="&lt;b&gt;How Enterprise MCP Authorization Works&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;How an AI app gets scoped, audience-bound, On-Behalf-Of access to a remote MCP server (MCP 2025-11-25 + OAuth 2.1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=24;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1040" height="84" as="geometry"/></mxCell>
        <mxCell id="b1_frame" value="Who's Involved (MCP 2025-11-25 + RFC 8693 OBO)" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;fontColor=#FDE047;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="1040" height="274" as="geometry"/></mxCell>
        <mxCell id="v_user" value="&lt;b&gt;User&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Resource owner&lt;/i&gt;&lt;br/&gt;Signs in &amp; approves scoped access in a browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b1_frame"><mxGeometry x="16" y="48" width="204" height="96" as="geometry"/></mxCell>
        <mxCell id="v_client" value="&lt;b&gt;MCP Client&lt;/b&gt;&lt;br/&gt;&lt;i&gt;OAuth 2.1 client&lt;/i&gt;&lt;br/&gt;Lives in host app (IDE, chat, ADK agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b1_frame"><mxGeometry x="258" y="48" width="220" height="96" as="geometry"/></mxCell>
        <mxCell id="v_server" value="&lt;b&gt;MCP Server&lt;/b&gt;&lt;br/&gt;&lt;i&gt;OAuth resource server&lt;/i&gt;&lt;br/&gt;Publishes RFC 9728 metadata, validates JWT + aud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b1_frame"><mxGeometry x="518" y="48" width="232" height="96" as="geometry"/></mxCell>
        <mxCell id="v_upstream" value="&lt;b&gt;Upstream API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;GitHub · Gmail · Jira&lt;/i&gt;&lt;br/&gt;Enforces per-caller RLS using RFC 8693 OBO token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b1_frame"><mxGeometry x="790" y="48" width="234" height="96" as="geometry"/></mxCell>
        <mxCell id="v_auth" value="&lt;b&gt;Authorization Server / IAM STS&lt;/b&gt; (Separate role: co-hosted or IdP-delegated)&lt;br/&gt;Authenticates user, renders consent, enforces PKCE, mints aud-bound MCP tokens &amp; RFC 8693 OBO upstream tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b1_frame"><mxGeometry x="258" y="180" width="492" height="78" as="geometry"/></mxCell>
        <mxCell id="v_obo_note" value="&lt;b&gt;NO STATIC KEYS / NO PASSTHROUGH&lt;/b&gt;&lt;br/&gt;MCP Server swaps caller JWT via RFC 8693 OBO (or per-user Token Vault) to block Confused-Deputy bypass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;" vertex="1" parent="b1_frame"><mxGeometry x="790" y="168" width="234" height="90" as="geometry"/></mxCell>
        <mxCell id="e_uc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;" edge="1" parent="b1_frame" source="v_user" target="v_client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;" edge="1" parent="b1_frame" source="v_client" target="v_server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_su" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;" edge="1" parent="b1_frame" source="v_server" target="v_upstream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ua" value="login + consent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="b1_frame" source="v_user" target="v_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ca" value="discover · register · token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;startArrow=classic;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="b1_frame" source="v_client" target="v_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sa" value="names AS + OBO swap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;dashed=1;startArrow=classic;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="b1_frame" source="v_server" target="v_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2_frame" value="The Flow, Step by Step (7 Phases · 16 Verified Protocol Steps)" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;fontColor=#FDE047;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="396" width="1040" height="734" as="geometry"/></mxCell>
        <mxCell id="step_box_1" value="&lt;b&gt;01 [Challenge]&lt;/b&gt; &amp;nbsp; CLIENT → SERVER: POST /mcp (no token) + MCP-Protocol-Version" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="46" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_2" value="&lt;b&gt;02 [Challenge]&lt;/b&gt; &amp;nbsp; SERVER → CLIENT: 401 + WWW-Authenticate: resource_metadata, scope" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="84" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_3" value="&lt;b&gt;03 [Discover]&lt;/b&gt; &amp;nbsp; CLIENT → SERVER: GET /.well-known/oauth-protected-resource (RFC 9728)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="122" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_4" value="&lt;b&gt;04 [Discover]&lt;/b&gt; &amp;nbsp; SERVER → CLIENT: authorization_servers, scopes_supported, resource" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="160" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_5" value="&lt;b&gt;05 [Discover]&lt;/b&gt; &amp;nbsp; CLIENT → AUTH: Fetch AS metadata (RFC 8414 / OIDC) + verify S256 PKCE" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="198" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_6" value="&lt;b&gt;06 [Register]&lt;/b&gt; &amp;nbsp; CLIENT → AUTH: Get client_id: Pre-registered &gt; CIMD &gt; DCR (legacy fallback)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="236" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_7" value="&lt;b&gt;07 [Authorize]&lt;/b&gt; &amp;nbsp; CLIENT → USER: Open /authorize + PKCE S256 + resource + state + redirect_uri" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="274" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_8" value="&lt;b&gt;08 [Authorize]&lt;/b&gt; &amp;nbsp; USER → AUTH: User signs in &amp; approves least-privilege scopes" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="312" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_9" value="&lt;b&gt;09 [Authorize]&lt;/b&gt; &amp;nbsp; AUTH → USER: Redirect callback with code + state + iss (RFC 9207)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="350" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_10" value="&lt;b&gt;10 [Authorize]&lt;/b&gt; &amp;nbsp; USER → CLIENT: Callback -&gt; client verifies state &amp; iss match (blocks CSRF/mix-up)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="388" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_11" value="&lt;b&gt;11 [Token]&lt;/b&gt; &amp;nbsp; CLIENT → AUTH: POST /token + code_verifier + redirect_uri + resource" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="426" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_12" value="&lt;b&gt;12 [Token]&lt;/b&gt; &amp;nbsp; AUTH → CLIENT: Access token (aud = this MCP server) + refresh_token" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="464" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_13" value="&lt;b&gt;13 [Call &amp; Verify]&lt;/b&gt; &amp;nbsp; CLIENT → SERVER: POST /mcp + Authorization: Bearer &lt;token&gt; + Mcp-Session-Id" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="502" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_14" value="&lt;b&gt;14 [Call &amp; Verify]&lt;/b&gt; &amp;nbsp; SERVER → SERVER: Validate signature, exp, aud == self, scope" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="540" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_15" value="&lt;b&gt;15 [Upstream OBO]&lt;/b&gt; &amp;nbsp; SERVER → AUTH: RFC 8693 OBO token swap (or per-user Token Vault)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F5F3FF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="578" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="step_box_16" value="&lt;b&gt;16 [Upstream OBO]&lt;/b&gt; &amp;nbsp; SERVER → UPSTREAM: Call upstream with caller-scoped OBO token -&gt; 200 OK" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F5F3FF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="616" width="1008" height="32" as="geometry"/></mxCell>
        <mxCell id="b2_stepup" value="&lt;b&gt;Step-Up:&lt;/b&gt; missing scope → 403 insufficient_scope → incremental re-auth  |  &lt;b&gt;Headless / M2M Agents:&lt;/b&gt; ID-JAG (RFC 7523 + RFC 8693) or client_credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=12;" vertex="1" parent="b2_frame"><mxGeometry x="16" y="684" width="1008" height="38" as="geometry"/></mxCell>
        <mxCell id="b3_frame" value="Enterprise Security Rules Baked In (Zero-Trust Checklist)" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;fontColor=#FDE047;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="1040" height="174" as="geometry"/></mxCell>
        <mxCell id="rule_1" value="&lt;b&gt;1. PKCE S256 + state + iss&lt;/b&gt;&lt;br/&gt;Mandatory S256 PKCE, state CSRF check, exact redirect_uri, and iss (RFC 9207) validation stop code interception &amp; mix-up." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" vertex="1" parent="b3_frame"><mxGeometry x="16" y="46" width="243" height="116" as="geometry"/></mxCell>
        <mxCell id="rule_2" value="&lt;b&gt;2. Audience-bound (RFC 8707)&lt;/b&gt;&lt;br/&gt;The resource parameter binds every token (aud) to a single MCP server. Resource servers reject cross-server tokens." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" vertex="1" parent="b3_frame"><mxGeometry x="271" y="46" width="243" height="116" as="geometry"/></mxCell>
        <mxCell id="rule_3" value="&lt;b&gt;3. No passthrough → OBO&lt;/b&gt;&lt;br/&gt;Never forward the client’s MCP token or share static server keys. Exchange via RFC 8693 OBO or a per-user Token Vault." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" vertex="1" parent="b3_frame"><mxGeometry x="526" y="46" width="243" height="116" as="geometry"/></mxCell>
        <mxCell id="rule_4" value="&lt;b&gt;4. Least-privilege &amp; step-up&lt;/b&gt;&lt;br/&gt;Ask only for challenged scopes. Missing permissions return 403 insufficient_scope to trigger incremental re-auth." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ECFDF5;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;" vertex="1" parent="b3_frame"><mxGeometry x="781" y="46" width="243" height="116" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
