    <mxCell id="an_bad_T146" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ NAME-DROPPING 20 LIBRARIES:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Listing every GitHub repo from this week&amp;rsquo;s feed with 0 prod depth&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T146" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ CITING FAILURE TRACES &amp;amp; SLAs:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Trade-offs, pass^5 gates, OBO zero-trust &amp;amp; sharp Q&amp;amp;A&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="fg_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;FIRST-8-MINUTE FILTER&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Instant Signal Read&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;One Phrase Reveals Demo Builder vs. Prod Owner&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Saying &lt;i&gt;&amp;ldquo;the prompt stops unauthorized queries&amp;rdquo;&lt;/i&gt; immediately triggers a Security/Systems No-Hire from any Staff panelist.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;60s Calibration Signal&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="fg_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;RECIPROCAL EVALUATION&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;2-Way Due Diligence&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Use Flag #4 to Audit the Employer Back!&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;If the hiring manager says they have &lt;b&gt;0 evals, 0 prod users &amp;amp; want &amp;ldquo;AGI in 3 weeks&amp;rdquo;&lt;/b&gt;, you just dodged a burnout trap.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;Protects Your Next 3 Years&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="fg_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: F · L · A · G · S&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#ECFDF5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Verbal Signal Audit&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Fewer Tools Deeper • Log pass^5 Not Vibes • Auth Below LLM • Grounded Cost Math • Sharp Reverse Questions&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Record 1 mock interview on your phone and scrub every &lt;b&gt;left-side Red Flag phrase&lt;/b&gt; from your vocabulary before loop week.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T146" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Seniority shows in how you talk about failure: &lt;b&gt;trade-offs over hype, pass^5 over demo accuracy, and RLS/OBO over prompt rules&lt;/b&gt;.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T146" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Google ADK + Vertex Eval + IAM STS + Spanner RLS&lt;/b&gt; ⇄ Production Postmortem Discipline&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T146" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Becomes your team&amp;rsquo;s &lt;b&gt;Bar-Raiser Interview Calibration Card&lt;/b&gt; as you grow to L6/L7&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

