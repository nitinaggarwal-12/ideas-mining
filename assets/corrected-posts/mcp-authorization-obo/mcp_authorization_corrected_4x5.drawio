<mxfile host="app.diagrams.net" agent="MCP-Auth-Production/2.1" version="24.7.0"><diagram id="mcp-auth-production-obo" name="MCP Auth (Zero-Trust + RFC 8693 OBO)"><mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1350" background="#F8FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" value="&lt;b&gt;How MCP Authorization Works (Production Architecture)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:12px'&gt;End-to-end OAuth 2.1, RFC 9728/8414 discovery, PKCE + audience binding &amp;amp; RFC 8693 OBO delegation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28" y="14" width="1024" height="92" as="geometry" /></mxCell><mxCell id="z1-hdr" value="1 · WHO'S INVOLVED — 5 ROLES &amp; TRUST BOUNDARIES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0F2942;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="122" width="1024" height="28" as="geometry" /></mxCell><mxCell id="who-0" value="&lt;font color='#1D4ED8'&gt;&lt;b&gt;Resource Owner&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;User / Browser&lt;/b&gt;&lt;br/&gt;Consents via browser PKCE. Headless WIF skips to Step 5." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="28.0" y="158" width="195" height="110" as="geometry" /></mxCell><mxCell id="who-1" value="&lt;font color='#6D28D9'&gt;&lt;b&gt;OAuth 2.1 Client&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;MCP Client&lt;/b&gt;&lt;br/&gt;Host IDE or agent runtime. Uses PKCE/WIF; zero PATs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="235.2" y="158" width="195" height="110" as="geometry" /></mxCell><mxCell id="who-2" value="&lt;font color='#047857'&gt;&lt;b&gt;Resource Server&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;MCP Server&lt;/b&gt;&lt;br/&gt;Publishes RFC 9728 meta, checks aud + Write HITL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="442.5" y="158" width="195" height="110" as="geometry" /></mxCell><mxCell id="who-3" value="&lt;font color='#B45309'&gt;&lt;b&gt;Separate IdP Role&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;Auth Server (IdP)&lt;/b&gt;&lt;br/&gt;Co-hosted or self-hosted. Issues JWT + RFC 8693 STS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="649.8" y="158" width="195" height="110" as="geometry" /></mxCell><mxCell id="who-4" value="&lt;font color='#0F766E'&gt;&lt;b&gt;External Services&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;b&gt;Downstream APIs&lt;/b&gt;&lt;br/&gt;Receives short-lived OBO tokens (sub+act), user ACL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="857.0" y="158" width="195" height="110" as="geometry" /></mxCell><mxCell id="z2-hdr" value="2 · THE FLOW, STEP BY STEP — RFC-COMPLIANT SEQUENCE (RFC 9728 / 8414 / 8707 / 9207 / 8693)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0F2942;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="280" width="1024" height="32" as="geometry" /></mxCell><mxCell id="lane-user" value="&lt;b&gt;User / Browser&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Interactive PKCE (WIF-&gt;5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="42" y="322" width="156" height="40" as="geometry" /></mxCell><mxCell id="ll-user" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="362" as="sourcePoint" /><mxPoint x="120" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lane-client" value="&lt;b&gt;MCP Client&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;OAuth 2.1 Public / WIF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="252" y="322" width="156" height="40" as="geometry" /></mxCell><mxCell id="ll-client" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="362" as="sourcePoint" /><mxPoint x="330" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lane-server" value="&lt;b&gt;MCP Server&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Resource Server (RFC 9728)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="462" y="322" width="156" height="40" as="geometry" /></mxCell><mxCell id="ll-server" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="362" as="sourcePoint" /><mxPoint x="540" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lane-auth" value="&lt;b&gt;Auth Server (IdP)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Co-hosted or Self-hosted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="672" y="322" width="156" height="40" as="geometry" /></mxCell><mxCell id="ll-auth" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="362" as="sourcePoint" /><mxPoint x="750" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lane-downstream" value="&lt;b&gt;Downstream APIs&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;GitHub · Gmail · Jira&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="882" y="322" width="156" height="40" as="geometry" /></mxCell><mxCell id="ll-downstream" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="362" as="sourcePoint" /><mxPoint x="960" y="1058" as="targetPoint" /></mxGeometry></mxCell><mxCell id="hop-1" value="1 · Call MCP tool (no token) [POST /mcp]" style="endArrow=classic;endFill=1;strokeColor=#1D4ED8;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="406" as="sourcePoint" /><mxPoint x="540" y="406" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-2" value="2 · Auth challenge [401 + WWW-Authenticate]" style="endArrow=classic;endFill=1;strokeColor=#B91C1C;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="446" as="sourcePoint" /><mxPoint x="330" y="446" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-3" value="3 · Fetch resource meta [GET /.well-known/oauth-protected-resource]" style="endArrow=classic;endFill=1;strokeColor=#047857;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="498" as="sourcePoint" /><mxPoint x="540" y="498" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-4" value="4 · RFC 9728 response [authorization_servers, scopes_supported]" style="endArrow=classic;endFill=1;strokeColor=#047857;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="538" as="sourcePoint" /><mxPoint x="330" y="538" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-5" value="5 · Fetch auth server metadata [RFC 8414 / OIDC (issuer, endpoints)]" style="startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#B45309;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="578" as="sourcePoint" /><mxPoint x="750" y="578" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-6" value="6 · Client ID resolution [Pre-reg &gt; CIMD (HTTPS) &gt; DCR (legacy)]" style="startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#6D28D9;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="630" as="sourcePoint" /><mxPoint x="750" y="630" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-7" value="7 · Open auth URL [PKCE S256 + state + resource + scope]" style="endArrow=classic;endFill=1;strokeColor=#6D28D9;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="702" as="sourcePoint" /><mxPoint x="120" y="702" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-8" value="8 · Authenticate &amp; grant scoped consent" style="endArrow=classic;endFill=1;strokeColor=#1D4ED8;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="742" as="sourcePoint" /><mxPoint x="750" y="742" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-9" value="9 · Callback w/ mix-up check [code + state + iss (RFC 9207)]" style="endArrow=classic;endFill=1;strokeColor=#B45309;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="782" as="sourcePoint" /><mxPoint x="330" y="782" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-10" value="10 · Exchange code + verifier [POST /token + resource (RFC 8707)]" style="endArrow=classic;endFill=1;strokeColor=#1D4ED8;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="834" as="sourcePoint" /><mxPoint x="750" y="834" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-11" value="11 · Return aud-bound JWT [aud=mcp-server, scope=mcp.read]" style="endArrow=classic;endFill=1;strokeColor=#047857;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="874" as="sourcePoint" /><mxPoint x="330" y="874" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-12" value="12 · Call tool (or 403 step-up) [Bearer JWT / 403 insufficient_scope]" style="endArrow=classic;endFill=1;strokeColor=#1D4ED8;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="926" as="sourcePoint" /><mxPoint x="540" y="926" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-13" value="13 · RFC 8693 OBO [urn:...:token-exchange · sub+act ≤5m]" style="startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#0F766E;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="1006" as="sourcePoint" /><mxPoint x="750" y="1006" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="hop-14" value="14 · Call downstream w/ OBO token (zero shared PAT) [User ACL enforced]" style="endArrow=classic;endFill=1;strokeColor=#0F766E;strokeWidth=2;rounded=0;labelBackgroundColor=#FFFFFF;fontColor=#0F172A;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="1046" as="sourcePoint" /><mxPoint x="960" y="1046" as="targetPoint" /><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell><mxCell id="verify-pill" value="✓ Verify sig, aud &amp; scope · Read=Auto / Write=HITL Approval" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;fontColor=#065F46;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="364" y="943" width="352" height="28" as="geometry" /></mxCell><mxCell id="z3-hdr" value="3 · PRODUCTION SECURITY INVARIANTS BAKED IN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0F2942;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="1078" width="1024" height="28" as="geometry" /></mxCell><mxCell id="inv-1" value="&lt;b&gt;1 · PKCE (S256) + RFC 9207 Mix-Up Check&lt;/b&gt;&lt;br/&gt;Mandate PKCE S256 + state + iss validation for browser/IDE apps. Headless backend agents use WIF/mTLS directly at Step 5 (/token)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="28" y="1114" width="506" height="78" as="geometry" /></mxCell><mxCell id="inv-2" value="&lt;b&gt;2 · Audience-Bound Tokens (RFC 8707)&lt;/b&gt;&lt;br/&gt;Include explicit resource URI on /authorize &amp; /token. MCP server enforces aud matches its own server URI to block cross-server replay." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="546" y="1114" width="506" height="78" as="geometry" /></mxCell><mxCell id="inv-3" value="&lt;b&gt;3 · No Token Passthrough + RFC 8693 OBO&lt;/b&gt;&lt;br/&gt;Never forward client MCP JWTs OR share static PAT/service keys. Exchange at STS for ≤5m user-scoped OBO token (sub + act)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="28" y="1200" width="506" height="78" as="geometry" /></mxCell><mxCell id="inv-4" value="&lt;b&gt;4 · Least-Privilege Scopes + HITL Gate&lt;/b&gt;&lt;br/&gt;Request narrow read scopes first; escalate lazily on demand via 403 insufficient_scope. Require HITL approval for write mutations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="546" y="1200" width="506" height="78" as="geometry" /></mxCell><mxCell id="ftr" value="REFERENCE GATEWAY: github.com/nitinaggarwal-12/ideas-mining (Zero-Bloat RFC 8693 OBO)  |  Nitin Aggarwal · 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0F2942;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="1296" width="1024" height="38" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>