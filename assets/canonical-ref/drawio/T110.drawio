    <mxCell id="hdr_T110" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #21 (T110) • LINKEDIN #1 VIRAL FORMAT • SUBWAY TRANSIT SKILL MAP&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Agent Career Map: &lt;span style='color:#2563EB;'&gt;4 M.E.T.R.O. Lines&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stop bingeing disconnected AI tutorials — ride the 4 sequenced &lt;b&gt;M.E.T.R.O.&lt;/b&gt; transit lines from L4 builder to L7 architect&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

