    <mxCell id="hdr_T109" value="&lt;div style='width:692px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#F3E8FF;color:#6D28D9;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #20 (T109) • NAUTILUS FIBONACCI GOLDEN SPIRAL • COMPOUNDING SKILLS&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Skill Flywheels: &lt;span style='color:#7C3AED;'&gt;Nautilus S.P.I.R.A.L.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stateless agents repeat Day-1 mistakes on Day 300 — compound org know-how into reusable &lt;b&gt;SKILL.md&lt;/b&gt; chambers&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="696" height="110" as="geometry"/></mxCell>

