ometry"/></mxCell>

    <mxCell id="an_bad_T124" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ 10 COOKS SHOUTING:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;45 overlapping conversations in the kitchen with &lt;b&gt;nobody checking the plate&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T124" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ 3-STAGE S.I.G.N.A.L.:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Prep → Cook → Pass Inspector&lt;/b&gt; via clean typed ticket handoffs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="c124_tl" value="&lt;div style='width:396px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #FCA5A5;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;N(N−1)/2 SWARM TAX&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;42s Chatter&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;10 Persona Bots Debating Unstructured Prose&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Every extra hop compounds latency, token cost &amp;amp; telephone-game drift.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;6.4× Token Burn + Drift&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="44" y="214" width="400" height="122" as="geometry"/></mxCell>
    <mxCell id="c124_tr" value="&lt;div style='width:396px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;3-STAGE TYPED DAG&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;1.4s Deterministic&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;1 Agent + Tools First; Subagents Only for Isolation&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Pass strict Pydantic contracts across &lt;b&gt;Plan → Execute → Verify&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;42s → 1.4s • +35pt Pass&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="476" y="214" width="400" height="122" as="geometry"/></mxCell>
    <mxCell id="c124_bot" value="&lt;div style='width:828px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.95);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#065F46;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: S · I · G · N · A · L&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;ADK Sequential&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Start Single-Agent • Isolate Context Only • Gate With Pydantic • Nullify Free-Text Debate • Audit Hops • Lock Latency SLO&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Add a subagent boundary only when two steps require &lt;b&gt;distinct security credentials or separate context windows&lt;/b&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="44" y="806" width="832" height="124" as="geometry"/></mxCell>

    <mxCell id="c1_T124" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;“Default to 1 agent + tools; add subagents only for &lt;b&gt;context isolation or security boundaries&lt;/b&gt;, connected by typed schemas.”&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T124" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Google ADK SequentialAgent / LoopAgent&lt;/b&gt; ⇄ LangGraph Typed StateGraph&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T124" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Replaced brittle 11-agent swarm with &lt;b&gt;3-stage ADK pipeline&lt;/b&gt;: latency &lt;b&gt;42s → 1.4s&lt;/b&gt;, accuracy &lt;b&gt;+35pt&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

