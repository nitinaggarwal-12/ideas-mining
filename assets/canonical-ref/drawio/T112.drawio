    <mxCell id="an_bad_T112" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ PROSE STYLE GUIDE:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;40-page wiki nobody reads before pushing &lt;b&gt;timestamped prompt bugs&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T112" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ 5-LINE PR D.I.F.F.:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Side-by-side red/green hunk&lt;/b&gt; any engineer applies in 2 minutes&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="df_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;− RED HUNK • NAIVE&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;5 Silent Prod Killers&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Timestamp Byte-0 + All-Tools + Admin Key&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Looks clean in a 20-line tutorial, yet busts prefix caches, leaks tenant data &amp;amp; spins on HTTP 503s.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;$0.44 / turn • 58% Pass&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="118" as="geometry"/></mxCell>
<mxCell id="df_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;+ GREEN HUNK • ENGINEERED&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;5-Line Staff+ Upgrade&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Frozen Prefix + Top-4 + OBO + URI Swap&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Same model, same 5 lines of orchestration — 31× cheaper and approved by enterprise InfoSec.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;$0.014 / turn • 95% Pass&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="118" as="geometry"/></mxCell>
<mxCell id="df_bl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;WHY DEV FEEDS BOOKMARK THIS&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Copy-Paste Utility&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Code Diffs Outperform Prose Advice 5:1&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Senior engineers scan red/green diffs in 4 seconds and immediately audit their own repo for line 14.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;#1 LinkedIn/IG Dev Save Format&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="790" width="404" height="124" as="geometry"/></mxCell>
<mxCell id="df_br" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: D · I · F · F&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#ECFDF5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;PR Review Checklist&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Dedup Retries • Isolate URI • Freeze Prefix • Federate OBO&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Pin these 4 checks into your repo&amp;rsquo;s &lt;b&gt;AGENTS.md&lt;/b&gt; &amp;amp; CI review bot so anti-patterns never merge.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;0 Regressions Merged&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="790" width="404" height="124" as="geometry"/></mxCell>

    <mxCell id="c1_T112" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Audit 5 lines in every agent PR: &lt;b&gt;byte-0 cache stability, lazy tool search, OBO token swap, retry breaker &amp;amp; URI pointers&lt;/b&gt;.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

