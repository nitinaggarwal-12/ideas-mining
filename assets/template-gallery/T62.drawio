      <!-- 01 | SUPERVISION ZONE -->
      <mxCell id="z61_1" value="01 | SUPERVISION ZONE" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="275" y="172" width="215" height="22" as="geometry"/></mxCell>
      <mxCell id="sup61" value="&lt;div style=&quot;padding:14px 14px;text-align:left;font-family:Inter,sans-serif;color:#FFFFFF;width:187px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;&quot;&gt;&lt;span style=&quot;font-size:16.5px;font-weight:900;line-height:1.18;letter-spacing:0.2px;&quot;&gt;SUPERVISOR&lt;br/&gt;AGENT&lt;/span&gt;&lt;span style=&quot;background:#B9D5FA;color:#0F172A;border:1.4px solid #0F172A;width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;&quot;&gt;01&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.2px;margin-top:10px;line-height:1.34;color:#F8FAFC;&quot;&gt;Analyzes high-level goals, decomposes tasks, coordinates specialized agents, and validates the final response.&lt;/div&gt;&lt;div style=&quot;margin-top:12px;display:flex;gap:5px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;background:#213C7A;color:#FFFFFF;padding:3px 7px;border-radius:8px;font-size:8.4px;font-weight:800;letter-spacing:0.2px;&quot;&gt;ORCHESTRATOR&lt;/span&gt;&lt;span style=&quot;background:#213C7A;color:#FFFFFF;padding:3px 7px;border-radius:8px;font-size:8.4px;font-weight:800;letter-spacing:0.2px;&quot;&gt;GOAL-DRIVEN&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#427CE6;strokeColor=#0F172A;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="275" y="196" width="215" height="170" as="geometry"/></mxCell>

