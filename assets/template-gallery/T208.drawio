    <mxCell id="bg_T208" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT208&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT208&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT208)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT208&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT208)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;g filter=&quot;url(#softDropT208)&quot;&gt;&lt;rect x=&quot;46&quot; y=&quot;348&quot; width=&quot;828&quot; height=&quot;418&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;!-- Central Balance Scale Pillar &amp; Beam --&gt;&lt;rect x=&quot;448&quot; y=&quot;420&quot; width=&quot;24&quot; height=&quot;252&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;rect x=&quot;374&quot; y=&quot;664&quot; width=&quot;172&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#0F172A&quot;/&gt;&lt;polygon points=&quot;460,392 482,424 438,424&quot; fill=&quot;#2563EB&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;2&quot;/&gt;&lt;!-- Balanced Horizontal Beam --&gt;&lt;line x1=&quot;176&quot; y1=&quot;436&quot; x2=&quot;744&quot; y2=&quot;436&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;6&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;436&quot; r=&quot;11&quot; fill=&quot;#F59E0B&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;2.5&quot;/&gt;&lt;!-- Left Pan: Multi-Model Generator Pool (Model Garden) --&gt;&lt;line x1=&quot;196&quot; y1=&quot;436&quot; x2=&quot;132&quot; y2=&quot;514&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;line x1=&quot;196&quot; y1=&quot;436&quot; x2=&quot;260&quot; y2=&quot;514&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;68&quot; y=&quot;514&quot; width=&quot;268&quot; height=&quot;142&quot; rx=&quot;16&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;rect x=&quot;94&quot; y=&quot;526&quot; width=&quot;216&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;202&quot; y=&quot;540.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;LEFT PAN: GENERATOR POOL&lt;/text&gt;&lt;text x=&quot;202&quot; y=&quot;570&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Vertex Model Garden&lt;/text&gt;&lt;text x=&quot;202&quot; y=&quot;592&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;• 1P: Gemini 4 / 3.8 Flash&lt;/text&gt;&lt;text x=&quot;202&quot; y=&quot;610&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;• Open: Gemma 3 / Llama / Mistral&lt;/text&gt;&lt;text x=&quot;202&quot; y=&quot;628&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;• 3P MaaS: DeepSeek / Qwen / Partner&lt;/text&gt;&lt;!-- Right Pan: Orthogonal Critic Judge (Different Model Family!) --&gt;&lt;line x1=&quot;724&quot; y1=&quot;436&quot; x2=&quot;660&quot; y2=&quot;514&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;line x1=&quot;724&quot; y1=&quot;436&quot; x2=&quot;788&quot; y2=&quot;514&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;rect x=&quot;584&quot; y=&quot;514&quot; width=&quot;268&quot; height=&quot;142&quot; rx=&quot;16&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;rect x=&quot;610&quot; y=&quot;526&quot; width=&quot;216&quot; height=&quot;22&quot; rx=&quot;11&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;718&quot; y=&quot;540.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;RIGHT PAN: ORTHOGONAL JUDGE&lt;/text&gt;&lt;text x=&quot;718&quot; y=&quot;570&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#064E3B&quot; text-anchor=&quot;middle&quot;&gt;Generator ≠ Judge Rule&lt;/text&gt;&lt;text x=&quot;718&quot; y=&quot;592&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;✓ Independent model family&lt;/text&gt;&lt;text x=&quot;718&quot; y=&quot;610&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;✓ Checks citations + schema&lt;/text&gt;&lt;text x=&quot;718&quot; y=&quot;628&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;✓ Zero self-grading bias!&lt;/text&gt;&lt;!-- Center Invariant Badge --&gt;&lt;rect x=&quot;352&quot; y=&quot;484&quot; width=&quot;216&quot; height=&quot;72&quot; rx=&quot;14&quot; fill=&quot;#0F172A&quot; stroke=&quot;#F59E0B&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;508&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;900&quot; fill=&quot;#FDE68A&quot; text-anchor=&quot;middle&quot;&gt;ANTI-SYCOPHANCY GATE&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;528&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.4&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;model(Gen) != model(Judge)&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;544&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#34D399&quot; text-anchor=&quot;middle&quot;&gt;Catches +38% subtle errors&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;738&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;MODEL GARDEN GOVERNANCE: Never let a model grade its own homework—pair diverse generators with orthogonal judges!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T208" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #119 (T208) • VERTEX MODEL GARDEN HIT • CROSS-JUDGE&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Model Garden: &lt;span style='color:#2563EB;'&gt;Orthogonal J.U.D.G.E.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Eliminate self-grading bias by enforcing &lt;b&gt;Generator ≠ Judge&lt;/b&gt; across Vertex Model Garden&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T208" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;Model Garden Evals&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T208" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ STUDENT GRADING THEIR OWN EXAM:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Same model approves its own hallucinated citation with 98% confidence&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T208" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ INDEPENDENT PEER-REVIEW SCALES:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Diverse generator family + orthogonal critic + deterministic checks&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="jg_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;SELF-GRADING ECHO CHAMBER&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;+27% Self-Bias Inflation&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Using the Exact Same Model to Generate &amp;amp; Judge Outputs&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Models share blind spots and stylistic preferences with themselves—&lt;b&gt;rubber-stamping subtle hallucinations&lt;/b&gt; as 5/5.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;27% False-Positive Eval Bias&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="jg_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MODEL GARDEN CROSS-JUDGE&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Generator ≠ Judge&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Pair Multi-Model Routing With an Orthogonal Critic Family&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Use &lt;b&gt;Vertex Model Garden&lt;/b&gt; to separate generation from evaluation—routing across 1P Gemini, Gemma, and partner critics.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;+38% Caught Silent Defects&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="jg_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: J · U · D · G · E&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Model Garden &amp;amp; Evals&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Join 1P Gemini, Gemma &amp;amp; Partner Models (Model Garden) • Use Orthogonal Generator ≠ Judge Critics • Detect Policy, Factuality &amp;amp; Schema Drift • Guard Production With Automatic Fallback Routing • Eliminate Single-Model Blind Spots&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Combine deterministic unit/schema assertions first, then run an &lt;b&gt;orthogonal LLM critic&lt;/b&gt; only on semantic edge cases.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T208" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#2563EB;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Enforcing &lt;b&gt;Generator ≠ Judge&lt;/b&gt; across Vertex Model Garden caught &lt;b&gt;38% more subtle factuality &amp;amp; policy defects&lt;/b&gt; than self-critique.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T208" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Vertex AI Model Garden (Gemini 4 + Gemma 3 + Partner Critics)&lt;/b&gt; ⇄ GenAI Eval Service&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T208" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Standardized &lt;b&gt;cross-model evaluation &amp;amp; automatic failover&lt;/b&gt; across 14 enterprise apps&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

