iddle&quot;&gt;VECTOR HYGIENE RULES&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;446&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;1. Model Namespace&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;464&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot;&gt;.vector_cache/emb-2/&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;480&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Never mix 001 &amp;amp; 2 vectors&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;514&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;2. Matryoshka Dims&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;532&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot;&gt;768 / 1536 / 3072d&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;548&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Tune storage vs. recall&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;582&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;3. Task-Type Prompting&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;600&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#1E40AF&quot;&gt;RETRIEVAL_QUERY&lt;/text&gt;&lt;text x=&quot;672&quot; y=&quot;616&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#059669&quot;&gt;RETRIEVAL_DOCUMENT&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;738&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;MULTIMODAL RAG RULE: Retrieve diagrams, code &amp;amp; video directly via cosine similarity—no lossy text OCR!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

