    <mxCell id="an_bad_T104" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ HOARDER DESKTOP:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Piling &lt;b&gt;400 open binders on your keyboard&lt;/b&gt; until you lose today’s note&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T104" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ S.O.L.A.R. GRAVITY:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Clean desk (L1) + drawer (8ms) + indexed shelf (42ms) + nightly filing&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="c104_tl" value="&lt;div style='width:344px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #FCD34D;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D97706;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;SUN + ORBIT 1 • S + O&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEF3C7;color:#92400E;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Zero Context Rot&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Slim L1 Sun (8k) + 8ms Scratchpad&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Keep active reasoning lean; offload raw tool payloads to 8ms Memorystore pointers.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#B45309;margin-top:4px;line-height:1.05;'&gt;0 Lost-in-the-Middle Decay&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="46" y="226" width="348" height="124" as="geometry"/></mxCell>
    <mxCell id="c104_tr" value="&lt;div style='width:344px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #93C5FD;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;ORBIT 2 • L&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;42ms Fact Recall&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Bitemporal User &amp;amp; Repo Fact Graph&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Versioned triples (&lt;b&gt;subject, valid_from, confidence&lt;/b&gt;) prevent stale facts overwriting truth.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#1D4ED8;margin-top:4px;line-height:1.05;'&gt;93% Cross-Session Recall&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="526" y="226" width="348" height="124" as="geometry"/></mxCell>
    <mxCell id="c104_bl" value="&lt;div style='width:344px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#047857;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;ORBIT 3 • A&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;GDPR Tombstones&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Archival Episode Lake &amp;amp; TTL Forgetting&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Store raw transcripts in BigQuery/GCS with right-to-forget — never stuff logs in L1.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;-81% Long-Session Cost&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="46" y="816" width="348" height="126" as="geometry"/></mxCell>
    <mxCell id="c104_br" value="&lt;div style='width:344px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;COMET • R (S·O·L·A·R)&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Async Consolidation&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Reflective Background Sleep Distill&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Async worker distills 50 episodic turns into 5 crisp semantic rules off the hot path.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;0ms Added Turn Latency&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="526" y="816" width="348" height="126" as="geometry"/></mxCell>

