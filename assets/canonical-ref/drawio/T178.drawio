x=&quot;248&quot; y=&quot;720&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;A. Unbounded Swarm&lt;/text&gt;&lt;text x=&quot;248&quot; y=&quot;736&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;Mean 75% • P10 = 4%!&lt;/text&gt;&lt;!-- VIOLIN 2 (cx=484): WIDE GAUSSIAN VANILLA RAG — Mean 75%, Noisy Spread --&gt;&lt;path d=&quot;M 484 404 C 508 424, 558 462, 558 494 C 558 532, 514 584, 484 622 C 454 584, 410 532, 410 494 C 410 462, 460 424, 484 404 Z&quot; fill=&quot;#FEF3C7&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;rect x=&quot;477&quot; y=&quot;452&quot; width=&quot;14&quot; height=&quot;92&quot; rx=&quot;4&quot; fill=&quot;#92400E&quot;/&gt;&lt;circle cx=&quot;484&quot; cy=&quot;482&quot; r=&quot;5.5&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;text x=&quot;484&quot; y=&quot;720&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;B. Naive Single-Pass&lt;/text&gt;&lt;text x=&quot;484&quot; y=&quot;736&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;Mean 75% • P10 = 51%&lt;/text&gt;&lt;!-- VIOLIN 3 (cx=718): TIGHT COMPACT HARNESS — Mean 89%, Zero Crash Tail! --&gt;&lt;path d=&quot;M 718 396 C 784 412, 792 436, 742 462 C 726 472, 722 486, 718 498 C 714 486, 710 472, 694 462 C 644 436, 652 412, 718 396 Z&quot; fill=&quot;#DCFCE7&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2.6&quot;/&gt;&lt;rect x=&quot;711&quot; y=&quot;418&quot; width=&quot;14&quot; height=&quot;36&quot; rx=&quot;4&quot; fill=&quot;#065F46&quot;/&gt;&lt;circle cx=&quot;718&quot; cy=&quot;434&quot; r=&quot;5.5&quot; fill=&quot;#FFFFFF&quot;/&gt;&lt;text x=&quot;718&quot; y=&quot;720&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;★ C. Guarded Harness&lt;/text&gt;&lt;text x=&quot;718&quot; y=&quot;736&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;Mean 89% • P10 = 82% ✓&lt;/text&gt;&lt;!-- Unoccluded Mean = 75% Line Pill Between Violin B and Violin C --&gt;&lt;rect x=&quot;568&quot; y=&quot;461.5&quot; width=&quot;122&quot; height=&quot;19&quot; rx=&quot;9.5&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;text x=&quot;629&quot; y=&quot;474&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Mean = 75% Line&lt;/text&gt;&lt;!-- Callout Pointing to Violin A's Hidden 0% Crash Bulb --&gt;&lt;rect x=&quot;334&quot; y=&quot;638&quot; width=&quot;248&quot; height=&quot;40&quot; rx=&quot;10&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;1.4&quot;/&gt;&lt;text x=&quot;458&quot; y=&quot;655&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;middle&quot;&gt;← HIDDEN 25% ZERO-SCORE BULB!&lt;/text&gt;&lt;text x=&quot;458&quot; y=&quot;670&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.6&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;Invisible inside a bar chart of means&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T178" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEF3C7;color:#92400E;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #89 (T178) • LINKEDIN DATA &amp; AI SCIENCE FAVORITE • VIOLIN DISTRIBUTION&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Beyond Averages: &lt;span style='color:#D97706;'&gt;Violin S.P.R.E.A.D. Plot&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Bar charts hide catastrophic bimodal tails — expose &lt;b&gt;P10&lt;/b&gt; floors with a &lt;b&gt;S.P.R.E.A.D.&lt;/b&gt; violin plot&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T178" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#D97706&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#D97706&quot; text-anchor=&quot;middle&quot;&gt;KDE + CVaR / P10&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T178" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ BAR CHART SAYING &quot;75% AVG&quot;:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Hides the fact that 1 in 4 customer runs crashed to 0%&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T178" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ SYMMETRIC VIOLIN + IQR BOX:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Exposes bimodal 0% bulb vs. tight P10=82% production floor&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="sp_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MEAN-ONLY BAR-CHART TRAP&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Hidden Tail Risk&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Two Architectures With &amp;ldquo;75% Average&amp;rdquo; Can Feel Opposite&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Model A scores &lt;b&gt;100%&lt;/b&gt; three times and &lt;b&gt;crashes to 0% once&lt;/b&gt; (75% mean), destroying enterprise user trust.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;25% Catastrophic Tail&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="sp_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;VIOLIN + IQR DENSITY SHAPE&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Full Tail Visibility&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Plot Full Kernel Density + Median/IQR + P10 Floor&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Violin silhouettes reveal &lt;b&gt;bimodal loop-crash bulbs&lt;/b&gt; instantly so you optimize worst-decile (&lt;b&gt;CVaR / P10&lt;/b&gt;) reliability.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;Zero Hidden 0% Crashes&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="sp_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: S · P · R · E · A · D&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Distributional Eval&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Show Full KDE Density • Plot Median &amp;amp; IQR • Reveal Bimodal Bulbs • Expose P10/CVaR Floor • Add Jittered Trial Dots • Drop Naked Bar Charts&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Nature, NeurIPS, and ICML figure guidelines strongly favor &lt;b&gt;violin/raincloud distributions&lt;/b&gt; over bar-and-plunger charts.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T178" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#D97706;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Averages lie on agentic workloads: we gate releases on &lt;b&gt;violin distribution shape and P10 floor&lt;/b&gt; so bimodal crash modes never reach customers.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

