    <mxCell id="an_bad_T160" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ WORLD MAP WITH STREETLIGHT WIRES:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Cramming IAM roles, VPC subnets &amp;amp; Python loops into 1 chart&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T160" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ 3 PROGRESSIVE OPTICAL ZOOMS:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;C1 System Context → C2 Deployable Pods → C3 Harness Hooks&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="c4_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;40-BOX SPAGHETTI DIAGRAM&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Mixed Abstraction&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Drawing Cloud VPCs Next to Python Classes on 1 Canvas&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Mixing &lt;b&gt;executive context, Kubernetes pods, and class hooks&lt;/b&gt; on one giant slide confuses both VPs and SWEs.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;0% Shared Understanding&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="c4_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;C4 TELESCOPIC ZOOM&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;C4 Zoom Standard&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Zoom Like Google Maps: C1 Context → C2 Pods → C3 Hooks&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Show &lt;b&gt;C1&lt;/b&gt; to executives, &lt;b&gt;C2&lt;/b&gt; to SRE/Security reviewers, and &lt;b&gt;C3&lt;/b&gt; to the engineers writing ADK callbacks.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;3× Faster Design Sign-Off&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="c4_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: L · E · N · S · E · S&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Architecture Clarity&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Level 1 Context (Actors) • Expand Container Pods (C2) • Narrow to Harness Hooks (C3) • Separate Audiences • Enforce 7-Node Cap • Skip C4 UML&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;In 2026 AI design docs, &lt;b&gt;3 clean telescopic lenses&lt;/b&gt; beat a 50-node cloud architecture poster every single time.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T160" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#2563EB;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Structure every AI design doc with &lt;b&gt;C4 zooms&lt;/b&gt;: C1 for user/data boundaries, C2 for mTLS/OBO containers, and C3 for in-process ADK guardrails.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T160" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Structurizr DSL + Draw.io #78 + Google ADK&lt;/b&gt; ⇄ Mermaid C4 + Backstage TechDocs&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T160" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Standardized &lt;b&gt;C1–C3 Architecture Reviews&lt;/b&gt; across 18 teams; halved ARB review cycles&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

