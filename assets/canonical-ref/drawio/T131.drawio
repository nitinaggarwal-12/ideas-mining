<mxfile host="embed.diagrams.net" modified="2026-11-02T06:10:00.000Z" agent="PromptCanvas-Minter"><diagram id="T131" name="45-Minute AI System Design Interview Stopwatch Pacing"><mxGraphModel dx="920" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1150" background="#FAF8F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="bg_T131" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT131&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT131&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT131)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT131&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT131)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;!-- Stopwatch Crown &amp; Outer Bezel at Center (460, 566) --&gt;&lt;g filter=&quot;url(#softDropT131)&quot;&gt;&lt;rect x=&quot;442&quot; y=&quot;346&quot; width=&quot;36&quot; height=&quot;22&quot; rx=&quot;6&quot; fill=&quot;#334155&quot;/&gt;&lt;rect x=&quot;452&quot; y=&quot;366&quot; width=&quot;16&quot; height=&quot;14&quot; fill=&quot;#64748B&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;566&quot; r=&quot;188&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;6&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;566&quot; r=&quot;176&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;!-- 5 Proportional 45-Minute Sectors (360 deg = 45 mins -&gt; 8 deg/min) --&gt;&lt;!-- 00-05m (0..40 deg): Clarify SLOs --&gt;&lt;path transform=&quot;translate(0,0)&quot; d=&quot;M 460 566 L 460.0 400.0 A 166 166 0 0 1 566.7 438.8 Z&quot; fill=&quot;#DBEAFE&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;!-- 05-13m (40..104 deg): API &amp; Token Math --&gt;&lt;path transform=&quot;translate(0,0)&quot; d=&quot;M 460 566 L 566.7 438.8 A 166 166 0 0 1 621.1 606.2 Z&quot; fill=&quot;#CCFBF1&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;!-- 13-28m (104..224 deg): Core Agent Harness --&gt;&lt;path transform=&quot;translate(0,0)&quot; d=&quot;M 460 566 L 621.1 606.2 A 166 166 0 0 1 344.7 685.4 Z&quot; fill=&quot;#D1FAE5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;!-- 28-39m (224..312 deg): Evals, OBO &amp; Guardrails (EXPLODED STAFF+ WEDGE!) --&gt;&lt;path transform=&quot;translate(-9,-3)&quot; d=&quot;M 460 566 L 343.3 686.8 A 168 168 0 0 1 335.2 453.6 Z&quot; fill=&quot;#EDE9FE&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;!-- 39-45m (312..360 deg): Cascades &amp; Cost Tradeoffs --&gt;&lt;path transform=&quot;translate(0,0)&quot; d=&quot;M 460 566 L 336.6 454.9 A 166 166 0 0 1 460.0 400.0 Z&quot; fill=&quot;#FEF3C7&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;!-- Crisp Sector Minute Badges Inside Mid-Radius --&gt;&lt;text x=&quot;494&quot; y=&quot;458&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;0–5m&lt;/text&gt;&lt;text x=&quot;562&quot; y=&quot;534&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F766E&quot; text-anchor=&quot;middle&quot;&gt;5–13m&lt;/text&gt;&lt;text x=&quot;482&quot; y=&quot;676&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12.5&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;13–28m (15m)&lt;/text&gt;&lt;text x=&quot;348&quot; y=&quot;576&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#6D28D9&quot; text-anchor=&quot;middle&quot;&gt;28–39m ★&lt;/text&gt;&lt;text x=&quot;418&quot; y=&quot;456&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;39–45m&lt;/text&gt;&lt;!-- Center Stopwatch Hub --&gt;&lt;circle cx=&quot;460&quot; cy=&quot;566&quot; r=&quot;46&quot; fill=&quot;#0F172A&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;4&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;562&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;14&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;45 MIN&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;579&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.5&quot; font-weight=&quot;800&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;LOOP PACE&lt;/text&gt;&lt;/g&gt;&lt;!-- 5 External Unoccluded Callout Badges + Outer-Arc Anchor Dots --&gt;&lt;line x1=&quot;517&quot; y1=&quot;410&quot; x2=&quot;664&quot; y2=&quot;392&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2&quot;/&gt;&lt;circle cx=&quot;517&quot; cy=&quot;410&quot; r=&quot;5.5&quot; fill=&quot;#2563EB&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;664&quot; y=&quot;358&quot; width=&quot;214&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;378&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#2563EB&quot;&gt;00–05 MIN • C: CLARIFY SLOs&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;398&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;Lock P99, Pass^5 &amp;amp; Scope&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;415&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Ask read-only vs. write tools first&lt;/text&gt;&lt;line x1=&quot;618&quot; y1=&quot;515&quot; x2=&quot;664&quot; y2=&quot;528&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;2&quot;/&gt;&lt;circle cx=&quot;618&quot; cy=&quot;515&quot; r=&quot;5.5&quot; fill=&quot;#0D9488&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;664&quot; y=&quot;494&quot; width=&quot;214&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#F0FDFA&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;514&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#0D9488&quot;&gt;05–13 MIN • L: LOAD &amp;amp; API MATH&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;534&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;QPS, Tok/Day &amp;amp; Typed JSON&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;551&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Define sync SSE vs. async webhook&lt;/text&gt;&lt;line x1=&quot;543&quot; y1=&quot;710&quot; x2=&quot;664&quot; y2=&quot;672&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2&quot;/&gt;&lt;circle cx=&quot;543&quot; cy=&quot;710&quot; r=&quot;5.5&quot; fill=&quot;#059669&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;664&quot; y=&quot;638&quot; width=&quot;214&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;676&quot; y=&quot;658&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot;&gt;13–28 MIN • O: ORCHESTRATE&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;678&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;ADK Loop + Hybrid RAG + MCP&lt;/text&gt;&lt;text x=&quot;676&quot; y=&quot;695&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Draw KV-pinned prefix + Saga WAL&lt;/text&gt;&lt;line x1=&quot;283&quot; y1=&quot;569&quot; x2=&quot;256&quot; y2=&quot;572&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;2.5&quot;/&gt;&lt;circle cx=&quot;283&quot; cy=&quot;569&quot; r=&quot;6&quot; fill=&quot;#7C3AED&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;42&quot; y=&quot;538&quot; width=&quot;214&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#F5F3FF&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;54&quot; y=&quot;558&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#7C3AED&quot;&gt;28–39 MIN • C: CRITIC &amp;amp; AUTH ★&lt;/text&gt;&lt;text x=&quot;54&quot; y=&quot;578&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;Golden Evals + OAuth 2.1 OBO&lt;/text&gt;&lt;text x=&quot;54&quot; y=&quot;595&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Where L6 Staff+ offers are won!&lt;/text&gt;&lt;line x1=&quot;393&quot; y1=&quot;414&quot; x2=&quot;256&quot; y2=&quot;396&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2&quot;/&gt;&lt;circle cx=&quot;393&quot; cy=&quot;414&quot; r=&quot;5.5&quot; fill=&quot;#D97706&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;42&quot; y=&quot;362&quot; width=&quot;214&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;54&quot; y=&quot;382&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#D97706&quot;&gt;39–45 MIN • K: KNEE TRADEOFFS&lt;/text&gt;&lt;text x=&quot;54&quot; y=&quot;402&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot;&gt;Flash→Argon Cascade &amp;amp; DR&lt;/text&gt;&lt;text x=&quot;54&quot; y=&quot;419&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot;&gt;Cut $/turn -88% + graceful brownout&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T131" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #42 (T131) • LINKEDIN SYSTEM DESIGN VIRAL HIT • 45-MINUTE STOPWATCH&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;System Design Loop: &lt;span style='color:#2563EB;'&gt;45m C.L.O.C.K. Pace&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Never run out of time before Evals &amp;amp; Guardrails — budget every minute of a 45m loop with &lt;b&gt;C.L.O.C.K.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T131" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;174&quot; height=&quot;52&quot; viewBox=&quot;0 0 174 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;172&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M36.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M30.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M39.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M32.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;36&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.4&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;74&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M124 9.5 C124 16 129 21 135.5 21 C129 21 124 26 124 32.5 C124 26 119 21 112.5 21 C119 21 124 16 124 9.5 Z&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;124&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.1&quot; font-weight=&quot;700&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;ADK + Vertex&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="722" y="26" width="174" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T131" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ 35m ON HAPPY-PATH BOXES:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Drawing generic load balancers until the interviewer says &lt;b&gt;&amp;ldquo;2 minutes left&amp;rdquo;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T131" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ MINUTE-28 STAFF+ WEDGE:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;11 dedicated minutes&lt;/b&gt; on pass^5 CI gates, OBO auth &amp;amp; Flash cascades&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="ck_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;#1 SYSTEM DESIGN FAIL&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Clock Bleed at Min 35&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Spending 30 Minutes Drawing Boxes &amp;amp; 0 Minutes on Evals&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Candidates burn 35 minutes on basic API/DB boxes and run out of time before covering &lt;b&gt;evals, OBO auth &amp;amp; failure recovery&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;Caps Level at L4 / No-Hire&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="ck_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#7C3AED;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MINUTE-28 STAFF+ PIVOT&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#F3E8FF;color:#6D28D9;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Proactive Driver&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Transition Yourself at Minute 28 Without Waiting for Prompts&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Say: &lt;i&gt;&amp;ldquo;Now that the happy path is clear, let&amp;rsquo;s lock down golden evals, OAuth OBO scopes, and P99 hedging.&amp;rdquo;&lt;/i&gt;&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#7C3AED;margin-top:4px;line-height:1.05;'&gt;+2.7× L6 Strong-Hire Signal&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="ck_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: C · L · O · C · K&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;45-Minute Whiteboard Pacing&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Clarify SLOs (5m) • Load Math (8m) • Orchestrate Harness (15m) • Critic &amp;amp; Auth (11m) • Knee Cost (6m)&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Write &lt;b&gt;5m / 13m / 28m / 39m&lt;/b&gt; in the corner of your whiteboard at minute 0 so you never miss the Staff+ reliability wedge.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

