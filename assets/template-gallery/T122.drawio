font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#991B1B&quot;&gt;&amp;lt; 0.75 • MANUAL&lt;/text&gt;&lt;text x=&quot;88&quot; y=&quot;656&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;700&quot; fill=&quot;#B91C1C&quot;&gt;Irreversible prod write / wire&lt;/text&gt;&lt;text x=&quot;88&quot; y=&quot;672&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;700&quot; fill=&quot;#B91C1C&quot;&gt;&amp;gt; $500 → Dual-key OIDC&lt;/text&gt;&lt;text x=&quot;88&quot; y=&quot;688&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;800&quot; fill=&quot;#DC2626&quot;&gt;Mandatory Human Takeover&lt;/text&gt;&lt;!-- Center Avionics Artificial Horizon Attitude Sphere (cx=460, cy=558, r=152) --&gt;&lt;g clip-path=&quot;url(#hudCircleClipT122)&quot;&gt;&lt;rect x=&quot;308&quot; y=&quot;406&quot; width=&quot;304&quot; height=&quot;152&quot; fill=&quot;#E0F2FE&quot;/&gt;&lt;rect x=&quot;308&quot; y=&quot;558&quot; width=&quot;304&quot; height=&quot;152&quot; fill=&quot;#FEF3C7&quot;/&gt;&lt;line x1=&quot;308&quot; y1=&quot;558&quot; x2=&quot;612&quot; y2=&quot;558&quot; stroke=&quot;#0284C7&quot; stroke-width=&quot;3&quot;/&gt;&lt;!-- Pitch Ladder Rungs --&gt;&lt;line x1=&quot;416&quot; y1=&quot;472&quot; x2=&quot;504&quot; y2=&quot;472&quot; stroke=&quot;#0369A1&quot; stroke-width=&quot;2&quot;/&gt;&lt;line x1=&quot;430&quot; y1=&quot;514&quot; x2=&quot;490&quot; y2=&quot;514&quot; stroke=&quot;#0369A1&quot; stroke-width=&quot;2&quot;/&gt;&lt;line x1=&quot;430&quot; y1=&quot;602&quot; x2=&quot;490&quot; y2=&quot;602&quot; stroke=&quot;#B45309&quot; stroke-width=&quot;2&quot;/&gt;&lt;line x1=&quot;416&quot; y1=&quot;644&quot; x2=&quot;504&quot; y2=&quot;644&quot; stroke=&quot;#B45309&quot; stroke-width=&quot;2&quot;/&gt;&lt;/g&gt;&lt;circle cx=&quot;460&quot; cy=&quot;558&quot; r=&quot;150&quot; fill=&quot;none&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;9&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;558&quot; r=&quot;144&quot; fill=&quot;none&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2.5&quot;/&gt;&lt;!-- Fixed Aircraft Flight-Director Wings in Center --&gt;&lt;polyline points=&quot;376,558 428,558 440,572&quot; fill=&quot;none&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;6&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;/&gt;&lt;polyline points=&quot;544,558 492,558 480,572&quot; fill=&quot;none&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;6&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;558&quot; r=&quot;9&quot; fill=&quot;#10B981&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;378&quot; y=&quot;436&quot; width=&quot;164&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;452&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;SKY: LOW BLAST RADIUS&lt;/text&gt;&lt;rect x=&quot;374&quot; y=&quot;654&quot; width=&quot;172&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#92400E&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;670&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;TERRAIN: IRREVERSIBLE OPS&lt;/text&gt;&lt;!-- Right Blast-Radius Altitude Tape (x=664..864, y=388..728) --&gt;&lt;rect x=&quot;664&quot; y=&quot;388&quot; width=&quot;200&quot; height=&quot;340&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;764&quot; y=&quot;416&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;REVERSIBILITY SCORE&lt;/text&gt;&lt;rect x=&quot;682&quot; y=&quot;434&quot; width=&quot;164&quot; height=&quot;84&quot; rx=&quot;12&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#CBD5E1&quot;/&gt;&lt;text x=&quot;696&quot; y=&quot;458&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot;&gt;TIER 0 • PURE READ&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;476&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;600&quot; fill=&quot;#334155&quot;&gt;82% of traffic • Zero popups&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;494&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#059669&quot;&gt;Auto-Run @ 380ms&lt;/text&gt;&lt;rect x=&quot;682&quot; y=&quot;532&quot; width=&quot;164&quot; height=&quot;84&quot; rx=&quot;12&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#CBD5E1&quot;/&gt;&lt;text x=&quot;696&quot; y=&quot;556&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#2563EB&quot;&gt;TIER 1 • SOFT WRITE&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;574&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;600&quot; fill=&quot;#334155&quot;&gt;15% traffic • Undoable draft&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;592&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#2563EB&quot;&gt;Run + 30s Undo Toast&lt;/text&gt;&lt;rect x=&quot;682&quot; y=&quot;630&quot; width=&quot;164&quot; height=&quot;74&quot; rx=&quot;12&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#CBD5E1&quot;/&gt;&lt;text x=&quot;696&quot; y=&quot;654&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#DC2626&quot;&gt;TIER 2 • HARD COMMIT&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;672&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;600&quot; fill=&quot;#334155&quot;&gt;3% traffic • DROP / Refund&lt;/text&gt;&lt;text x=&quot;696&quot; y=&quot;690&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#DC2626&quot;&gt;Hard Pause + Diff Sign-Off&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T122" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#E0F2FE;color:#0369A1;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #33 (T122) • YOUTUBE &amp; LINKEDIN HIT • AVIONICS AUTONOMY HUD&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Autonomy Dial: &lt;span style='color:#0284C7;'&gt;Avionics P.I.L.O.T.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Neither 100% YOLO autonomy nor popup-spam works — fly calibrated &lt;b&gt;P.I.L.O.T.&lt;/b&gt; risk envelopes like modern avionics&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

