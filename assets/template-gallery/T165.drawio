    <mxCell id="hdr_T165" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#ECFDF5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T165) • ISOMETRIC MAKER MONOLITH VS SHARDS • SWE FLOW&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Maker Schedule: &lt;span style='color:#059669;'&gt;Deep-Work B.L.O.C.K.S.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Why 5 scattered 30-minute syncs destroy a 40-hour engineering week — reclaim flow via &lt;b&gt;B.L.O.C.K.S.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T165" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;Staff+ Execution&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T165" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ SWISS-CHEESE 30M GAPS:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;5 status calls spaced 45 minutes apart all day long&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T165" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ MORNING MONOLITH + PM BATCH:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;9am–1pm uninterrupted build + 2pm–4:30pm batched reviews&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="c165_tl" value="&lt;div style='width:398px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #FCA5A5;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;30-MINUTE CONFETTI DEATH&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Maker-Schedule Law&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;1 Scattered Sync Ruins a 4-Hour Half-Day&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Distributed systems &amp;amp; eval harnesses require &lt;b&gt;3+ uninterrupted hours&lt;/b&gt; to load mental state.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;-71% Deep Architecture Output&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="212" width="402" height="122" as="geometry"/></mxCell>
    <mxCell id="c165_tr" value="&lt;div style='width:398px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;DEFENSIVE CALENDAR DESIGN&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;EM + Staff Pact&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;9am–1pm Maker Monoliths + Async Status&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Replace verbal status calls with &lt;b&gt;5-bullet async docs&lt;/b&gt;; batch reviews after 2pm.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;+24 Hours Deep Flow / Week&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="476" y="212" width="402" height="122" as="geometry"/></mxCell>
    <mxCell id="c165_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.95);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#065F46;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: B · L · O · C · K · S&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Staff+ Culture&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Book 9–1pm Holds • Lock No-Meeting Wed • Offload Status to Docs • Cluster 1:1s &gt;2pm • Kill No-Agenda Calls • Snooze Chat&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;The highest-ROI leverage an Engineering Manager gives Senior/Staff ICs is &lt;b&gt;20+ protected Maker hours every week&lt;/b&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="804" width="836" height="126" as="geometry"/></mxCell>

    <mxCell id="c1_T165" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;“AI coding assistants speed up typing, not deep system design: we protect &lt;b&gt;9am–1pm Maker blocks&lt;/b&gt; and run status updates asynchronously.”&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T165" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Google Calendar Focus Time + Workspace Async Docs&lt;/b&gt; ⇄ Clockwise + Linear Async Updates&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T165" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Rolled out &lt;b&gt;Org Maker-Hours Charter&lt;/b&gt; across 65 engineers; cut sprint spillover &lt;b&gt;-48%&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

