amp Crossed Out on Left --&gt;&lt;circle cx=&quot;128&quot; cy=&quot;568&quot; r=&quot;48&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#DC2626&quot; stroke-width=&quot;3&quot;/&gt;&lt;text x=&quot;128&quot; y=&quot;564&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#991B1B&quot; text-anchor=&quot;middle&quot;&gt;✕ NO UUID&lt;/text&gt;&lt;text x=&quot;128&quot; y=&quot;581&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;800&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;AT BYTE 0&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

