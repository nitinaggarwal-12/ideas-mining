      </mxCell>
      <mxCell id="cli_deploy" value="CLI STEP 03A • DEPLOY
&gt; adk deploy --all
Packages skill + manifest into managed VPC sandbox." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F172A;strokeColor=#0284C7;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1">
