"/></mxCell>

    <mxCell id="an_bad_T122" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ POPUP SPAM OR YOLO:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Asking permission to &lt;b&gt;check the weather&lt;/b&gt; or auto-firing &lt;b&gt;DROP TABLE&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T122" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ AVIONICS P.I.L.O.T. HUD:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;82% silent autopilot reads + 15% undoable drafts + 3% OIDC hard gates&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="hd_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;APPROVAL FATIGUE TRAP&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Popups on Every Read&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Asking Confirmation on Every Tool Trains Blind &quot;Yes&quot;&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;When agents nag users to approve harmless grep/read calls, operators rubber-stamp the 1 destructive prod mutation.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;89% Rubber-Stamp Risk&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="122" as="geometry"/></mxCell>
<mxCell id="hd_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;RISK × REVERSIBILITY&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;FAA Autopilot Law&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Gate by Blast Radius &amp;amp; Undoability, Not Tool Count&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Auto-approve 82% read-only &amp;amp; draft steps; interrupt humans strictly on the 3% high-impact irreversible commits.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;-91% Nagging • 0 Disasters&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="122" as="geometry"/></mxCell>
<mxCell id="hd_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: P · I · L · O · T&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#E0F2FE;color:#0369A1;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Calibrated Autonomy Envelope&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Profile Blast Radius • Classify Undoability • Log Dry-Run Diff • OIDC Sign-Off • Telemetry Blackbox&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Tag every MCP tool schema with &lt;b&gt;readOnlyHint / destructiveHint&lt;/b&gt; so your runtime HUD switches Autopilot ⇄ Manual deterministically.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="786" width="836" height="124" as="geometry"/></mxCell>

