o --&gt;&lt;rect x=&quot;66&quot; y=&quot;568&quot; width=&quot;788&quot; height=&quot;68&quot; rx=&quot;12&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;rect x=&quot;78&quot; y=&quot;580&quot; width=&quot;136&quot; height=&quot;44&quot; rx=&quot;9&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;146&quot; y=&quot;606&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;🔊 NATIVE AUDIO&lt;/text&gt;&lt;rect x=&quot;226&quot; y=&quot;580&quot; width=&quot;194&quot; height=&quot;44&quot; rx=&quot;8&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;323&quot; y=&quot;606&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;Synced Voiceover + Ambient&lt;/text&gt;&lt;rect x=&quot;430&quot; y=&quot;580&quot; width=&quot;210&quot; height=&quot;44&quot; rx=&quot;8&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;535&quot; y=&quot;606&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;Sample-Locked Lip-Sync&lt;/text&gt;&lt;rect x=&quot;650&quot; y=&quot;580&quot; width=&quot;192&quot; height=&quot;44&quot; rx=&quot;8&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;746&quot; y=&quot;606&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;SFX + SynthID Watermark&lt;/text&gt;&lt;!-- Vertical Playhead Sync Line --&gt;&lt;line x1=&quot;425&quot; y1=&quot;366&quot; x2=&quot;425&quot; y2=&quot;654&quot; stroke=&quot;#DC262