; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;485&quot; y=&quot;440&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#991B1B&quot; text-anchor=&quot;middle&quot;&gt;⚡ Barge-In Gate&lt;/text&gt;&lt;text x=&quot;485&quot; y=&quot;456&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;Flush buffer &amp;lt;90ms&lt;/text&gt;&lt;!-- Async Fork Down to Extended Thinking + Background Tool Lane --&gt;&lt;line x1=&quot;210&quot; y1=&quot;484&quot; x2=&quot;210&quot; y2=&quot;548&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;3&quot; stroke-dasharray=&quot;5 3&quot;/&gt;&lt;polygon points=&quot;204,544 210,554 216,544&quot; fill=&quot;#7C3AED&quot;/&gt;&lt;line x1=&quot;650&quot; y1=&quot;554&quot; x2=&quot;650&quot; y2=&quot;488&quot; stroke=&quot;#059669&quot; stroke-width=&quot;3&quot;/&gt;&lt;polygon points=&quot;644,492 650,482 656,492&quot; fill=&quot;#059669&quot;/&gt;&lt;!-- Lane 2: Extended Thinking + Non-Blocking Async Tool Execution (Bottom) --&gt;&lt;rect x=&quot;68&quot; y=&quot;554&quot; width=&quot;784&quot; height=&quot;148&quot; rx=&quot;14&quot; fill=&quot;#F5F3FF&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;2&quot;/&gt;&lt;rect x=&quot;84&quot; y=&quot;566&quot; width=&quot;314&quot; height=&quot;20&quot; rx=&quot;10&quot; fill=&quot;#7C3AED&quot;/&gt;&lt;text x=&quot;241&quot; y=&quot;579.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;ASYNC REASONING (gemini-3.8-live-extended-thinking)&lt;/text&gt;&lt;text x=&quot;836&quot; y=&quot;579.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#5B21B6&quot; text-anchor=&quot;end&quot;&gt;Zero Dead Silence!&lt;/text&gt;&lt;rect x=&quot;88&quot; y=