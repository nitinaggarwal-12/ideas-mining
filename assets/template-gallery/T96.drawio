<mxCell id="ul_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;UPPER BULB&lt;/span&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;N Agent Frameworks&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Heterogeneous Cloud Agents&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;GCP ADK, AWS AgentCore, LangGraph &amp;amp; coding agents speak different SDKs.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;N × M → N + M&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="268" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="ur_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#4F46E5;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;W + A • DISCOVERY&lt;/span&gt;&lt;span style='background:#E0E7FF;color:#3730A3;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;.well-known/agent.json&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Well-Known AgentCard Spec&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Publish capabilities, input modalities &amp;amp; auth schemes without hardcoding SDKs.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#4F46E5;margin-top:4px;line-height:1.05;'&gt;Zero Glue Wrappers&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="636" y="268" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="ml_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#D97706;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;THE NARROW WAIST&lt;/span&gt;&lt;span style='background:#FEF3C7;color:#92400E;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;I • Identity mTLS&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Signed Task + SSE Envelope&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;All peer delegation &amp;amp; tool calls pass through 1 auditable protocol bottleneck.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#D97706;margin-top:4px;line-height:1.05;'&gt;1 Universal Contract&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="518" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="mr_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#B45309;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;S • STREAMING&lt;/span&gt;&lt;span style='background:#FEF3C7;color:#92400E;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Async Artifacts&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Stateful Lifecycle &amp;amp; Cancel&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Stream long-running progress chunks, human-input pauses &amp;amp; typed artifacts.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#B45309;margin-top:4px;line-height:1.05;'&gt;Sub-50ms SSE Hop&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="636" y="518" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="bl_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;LOWER BULB&lt;/span&gt;&lt;span style='background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;M Enterprise Systems&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Plug Any SaaS or Warehouse&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Add a new database or 3P SaaS once at the waist — every agent inherits it.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;-82% Integration Time&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="764" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="br_96" value="&lt;div style='width:246px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#0F766E;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;T • TELEMETRY&lt;/span&gt;&lt;span style='background:#CCFBF1;color:#115E59;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;W · A · I · S · T&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;W3C Traceparent Across Clouds&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;1 distributed trace span links GCP orchestrator → AWS peer → SaaS tool.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#0F766E;margin-top:4px;line-height:1.05;'&gt;100% Cross-Cloud Trace&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="636" y="764" width="250" height="120" as="geometry"/></mxCell>

