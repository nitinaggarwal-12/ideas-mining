    <mxCell id="hdr_T128" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#F3E8FF;color:#6D28D9;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T128) • ACOUSTIC EQ RUNTIME CONSOLE • 5 DYNAMIC AGENT KNOBS&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;5 Agent Knobs: &lt;span style='color:#7C3AED;'&gt;Studio M.I.X.E.R.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stop hardcoding LLM flags in code — tune the 5 runtime &lt;b&gt;M.I.X.E.R.&lt;/b&gt; faders per workload class&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

