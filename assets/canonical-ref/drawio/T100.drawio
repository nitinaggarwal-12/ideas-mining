&lt;!-- Leader Pins --&gt;&lt;line x1=&quot;366&quot; y1=&quot;378&quot; x2=&quot;462&quot; y2=&quot;294&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2&quot;/&gt;&lt;line x1=&quot;322&quot; y1=&quot;622&quot; x2=&quot;356&quot; y2=&quot;578&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;2&quot;/&gt;&lt;line x1=&quot;654&quot; y1=&quot;548&quot; x2=&quot;676&quot; y2=&quot;502&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2&quot;/&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T100" value="&lt;div style='width:692px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DBEAFE;color:#1E40AF;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #11 (T100) • MESHING 3-GEAR CLOCKWORK DRIVETRAIN • STATEFUL CONTINUITY&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Long-Horizon Agents: &lt;span style='color:#2563EB;'&gt;Clockwork G.E.A.R.S.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;In-memory while-loops die on pod restarts — lock Planner, Checkpointer &amp;amp; Saga Executor in meshing &lt;b&gt;G.E.A.R.S.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="696" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T100" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;156&quot; height=&quot;52&quot; viewBox=&quot;0 0 156 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;154&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M37.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M31.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M40.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M33.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;37&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.5&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;75&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M115 9.5 C115 16 120 21 126.5 21 C120 21 115 26 115 32.5 C115 26 110 21 103.5 21 C110 21 115 16 115 9.5 Z&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;115&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;Workflows + ADK&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="738" y="26" width="156" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T100" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ IN-RAM WHILE(TRUE):&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Slipping rubber belt — &lt;b&gt;1 network blip at minute 45 wipes all progress&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T100" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ INTERLOCKING G.E.A.R.S.:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Swiss ratchet escapement&lt;/b&gt; — every tooth locks durably before the next turns&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="g1_c100" value="&lt;div style='width:402px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;GEAR 1 • G + E&lt;/span&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Deterministic Graph&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Graph Decomposition &amp;amp; Event Sourcing&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Break 72-hour workflows into explicit typed step nodes instead of a fragile 100-turn while-loop.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;Zero Infinite Spin&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="468" y="218" width="406" height="120" as="geometry"/></mxCell>
<mxCell id="g3_c100" value="&lt;div style='width:234px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#D97706;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;GEAR 3 • R + S&lt;/span&gt;&lt;span style='background:#FEF3C7;color:#92400E;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Saga Compensation&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Rollback &amp;amp; Resume Tooth&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Every write registers an undo action; worker crashes resume from exact step N.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#D97706;margin-top:4px;line-height:1.05;'&gt;0 Orphaned Writes&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="644" y="368" width="238" height="126" as="geometry"/></mxCell>
<mxCell id="g2_c100" value="&lt;div style='width:272px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;GEAR 2 • A&lt;/span&gt;&lt;span style='background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;ACID Checkpoint&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Atomic Checkpoint After Every Tooth&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Persist thread_id + tool receipt before advancing gear; enables time-travel fork &amp;amp; human pause.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;100% Crash Recovery&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="586" width="276" height="132" as="geometry"/></mxCell>
<mxCell id="mn_c100" value="&lt;div style='width:830px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;MNEMONIC: G · E · A · R · S&lt;/span&gt;&lt;span style='background:#ECFDF5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;72-Hour Autonomous Continuity&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Graph Nodes • Event Log • Atomic Checkpoint • Rollback Saga • Sleep/Resume&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;When pod spot-preemption hits at step 37 of 40, Gear 2 rehydrates state on a fresh worker in &lt;b&gt;18ms&lt;/b&gt; without re-billing steps 1–36.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="786" width="834" height="120" as="geometry"/></mxCell>

