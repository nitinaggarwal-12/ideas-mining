ial,sans-serif&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Sim-to-Real Policy Distillation&lt;/text&gt;&lt;!-- Arrows Into Center Genie 4 3D Isometric Holodeck --&gt;&lt;line x1=&quot;282&quot; y1=&quot;445&quot; x2=&quot;346&quot; y2=&quot;478&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;3&quot;/&gt;&lt;polygon points=&quot;340,481 351,481 345,471&quot; fill=&quot;#2563EB&quot;/&gt;&lt;line x1=&quot;348&quot; y1=&quot;576&quot; x2=&quot;288&quot; y2=&quot;595&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;3&quot;/&gt;&lt;polygon points=&quot;293,599 282,597 289,589&quot; fill=&quot;#7C3AED&quot;/&gt;&lt;!-- Center 3D Isometric Holodeck Stage --&gt;&lt;rect x=&quot;352&quot; y=&quot;376&quot; width=&quot;318&quot; height=&quot;316&quot; rx=&quot;18&quot; fill=&quot;#0F172A&quot; stroke=&quot;#38BDF8&quot; stroke-width=&quot;2.6&quot;/&gt;&lt;text x=&quot;511&quot; y=&quot;402&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;DEEPMIND GENIE 4 WORLD MODEL&lt;/text&gt;&lt;text x=&quot;511&quot; y=&quot;420&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.4&quot; font-weight=&quot;800&quot; fill=&quot;#34D399&quot; text-anchor=&quot;middle&quot;&gt;Interactive 24fps 3D + Native Audio&lt;/text&gt;&lt;!-- Isometric Wireframe Floor &amp; 3D Cube --&gt;&lt;polygon points=&quot;511,452 634,516 511,580 388,516&quot; fill=&quot;#1E293B&quot; stroke=&quot;#38BDF8&quot; stroke-width=&quot;1.6&quot;/&gt;&lt;line x1=&quot;450&quot; y1=&quot;484&quot; x2=&quot;572&quot; y2=&quot;548&quot; stroke=&quot;#475569&quot; stroke-width=&quot;1.1&quot;/&gt;&lt;line x1=&quot;572&quot; y1=&quot;484&quot; x2=&quot;450&quot; y2=&quot;548&quot; stroke=&quot;#475569&quot; stroke-width=&quot;1.1&quot;/&gt;&lt;!-- 3D Isometric Object --&gt;&lt;polygon points=&quot;511,474 551,495 511,516 471,495&quot; fill=&quot;#38BDF8&quot;/&gt;&lt;polygon points=&quot;471,495 511,516 511,558 471,537&quot; fill=&quot;#0284C7&quot;/&gt;&lt;polygon points=&quot;511,516 551,495 551,537 511,558&quot; fill=&quot;#0369A1&quot;/&gt;&lt;rect x=&quot;380&quot; y=&quot;604&quot; width=&quot;262&quot; height=&quot;66&quot; rx=&quot;12&quot; fill=&quot;#1E293B&quot; stroke=&quot;#34D399&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;511&quot; y=&quot;625&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;Causal Physics + Spatial Memory&lt;/text&gt;&lt;text x=&quot;511&quot; y=&quot;643&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#34D399&quot; text-anchor=&quot;middle&quot;&gt;Object permanence + synchronized audio&lt;/text&gt;&lt;text x=&quot;511&quot; y=&quot;659&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8&quot; font-weight=&quot;800&quot; fill=&quot;#FDE68A&quot; text-anchor=&quot;middle&quot;&gt;Steerable frame-by-frame in real time&lt;/text&gt;&lt;!-- Right Side: Downstream Applications --&gt;&lt;rect x=&quot;694&quot; y=&quot;384&quot; width=&quot;158&quot; height=&quot;272&quot; rx=&quot;14&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;773&quot; y=&quot;410&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.6&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;WHY GENIE 4?&lt;/text&gt;&lt;text x=&quot;773&quot; y=&quot;446&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;1. Robotics &amp;amp; Drones&lt;/text&gt;&lt;text x=&quot;773&quot; y=&quot;464&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;7.8&quot; font-weigh