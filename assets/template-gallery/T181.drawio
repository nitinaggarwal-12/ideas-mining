    <mxCell id="c181_tr" value="&lt;div style='width:396px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:rgba(255,255,255,0.94);border:1.4px solid #6EE7B7;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;SEALED TEMPORAL HOLDOUT&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DCFCE7;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;0.9pt Gap&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Evaluate Strictly on Post-Cutoff Private PRs&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Stamp private vaults with canary GUIDs &amp;amp; AST variable renames every month.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#047857;margin-top:4px;line-height:1.05;'&gt;True Production Generalization&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="476" y="212" width="400" height="120" as="geometry"/></mxCell>
