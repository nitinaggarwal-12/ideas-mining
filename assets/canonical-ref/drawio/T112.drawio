<mxfile host="embed.diagrams.net" modified="2026-11-02T06:10:00.000Z" agent="PromptCanvas-Minter"><diagram id="T112" name="Git Pull Request Red-Green Code Diff Spotlight"><mxGraphModel dx="920" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1150" background="#FAF8F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="bg_T112" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT112&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT112&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT112)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT112&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT112)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;g filter=&quot;url(#softDropT112)&quot;&gt;&lt;!-- Light-Mode GitHub PR Diff Window (x=48..872, y=346..766) --&gt;&lt;rect x=&quot;48&quot; y=&quot;346&quot; width=&quot;824&quot; height=&quot;420&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;!-- Window Header Bar --&gt;&lt;path d=&quot;M 48 364 Q 48 346 66 346 L 854 346 Q 872 346 872 364 L 872 394 L 48 394 Z&quot; fill=&quot;#F1F5F9&quot;/&gt;&lt;circle cx=&quot;72&quot; cy=&quot;370&quot; r=&quot;6&quot; fill=&quot;#EF4444&quot;/&gt;&lt;circle cx=&quot;92&quot; cy=&quot;370&quot; r=&quot;6&quot; fill=&quot;#F59E0B&quot;/&gt;&lt;circle cx=&quot;112&quot; cy=&quot;370&quot; r=&quot;6&quot; fill=&quot;#10B981&quot;/&gt;&lt;text x=&quot;136&quot; y=&quot;374&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#0F172A&quot;&gt;PR #418 • src/agent/tool_runner.py&lt;/text&gt;&lt;rect x=&quot;734&quot; y=&quot;358&quot; width=&quot;118&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#DCFCE7&quot; stroke=&quot;#86EFAC&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;text x=&quot;793&quot; y=&quot;374&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#166534&quot; text-anchor=&quot;middle&quot;&gt;+5  −5  ✓ MERGED&lt;/text&gt;&lt;!-- RED REMOVED HUNK (Anti-Pattern) --&gt;&lt;rect x=&quot;64&quot; y=&quot;408&quot; width=&quot;792&quot; height=&quot;154&quot; rx=&quot;10&quot; fill=&quot;#FEF2F2&quot; stroke=&quot;#FECACA&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;rect x=&quot;64&quot; y=&quot;408&quot; width=&quot;6&quot; height=&quot;154&quot; rx=&quot;3&quot; fill=&quot;#DC2626&quot;/&gt;&lt;text x=&quot;84&quot; y=&quot;432&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#991B1B&quot;&gt;- 14  prompt = f&quot;{now_iso()} {SYSTEM_PROMPT}&quot;        # Busts L1 KV cache every turn!&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;460&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#991B1B&quot;&gt;- 15  tools  = mcp.list_all_tools()                   # Dumps 85 schemas (55,240 tok)&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;488&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#991B1B&quot;&gt;- 16  out    = admin_client.call(tool, raw_llm_args)  # Shared key + unvalidated JSON&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;516&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#991B1B&quot;&gt;- 17  while out.error: out = retry(tool)              # Unbounded $400 retry storm&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;544&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#991B1B&quot;&gt;- 18  history.append(out.full_50kb_payload)           # Context rot by turn 12&lt;/text&gt;&lt;!-- GREEN ADDED HUNK (Production Harness) --&gt;&lt;rect x=&quot;64&quot; y=&quot;576&quot; width=&quot;792&quot; height=&quot;172&quot; rx=&quot;10&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#A7F3D0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;rect x=&quot;64&quot; y=&quot;576&quot; width=&quot;6&quot; height=&quot;172&quot; rx=&quot;3&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;84&quot; y=&quot;602&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#065F46&quot;&gt;+ 14  prefix = cache.pin(FROZEN_SYSTEM_PREFIX)        # 92% KV cache hit (0.8s TTFT)&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;630&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#065F46&quot;&gt;+ 15  tools  = mcp.search_top_k(intent, k=4)          # -97.5% schema token burn&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;658&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#065F46&quot;&gt;+ 16  jwt    = sts.exchange_obo(user_token, tool.acl) # Per-user RFC 8693 scope&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;686&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#065F46&quot;&gt;+ 17  out    = breaker.call_once(jwt, Schema(args))   # Hash-deduped + CFG typed&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;714&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;12&quot; font-weight=&quot;700&quot; fill=&quot;#065F46&quot;&gt;+ 18  history.append(artifact_store.put_uri(out))     # Slim URI pointer in L1&lt;/text&gt;&lt;text x=&quot;84&quot; y=&quot;736&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot;&gt;✓ Staff+ Reviewer LGTM: -94% cost/turn • 0 cross-tenant leaks • 99.2% pass^5&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T112" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#DCFCE7;color:#166534;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #23 (T112) • LINKEDIN &amp; IG DEV SAVE-MAGNET • GIT PR DIFF SPOTLIGHT&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Agent PR Review: &lt;span style='color:#059669;'&gt;The 5-Line D.I.F.F.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;5 lines of Python separate a fragile demo from a Staff+ production harness — inspect the exact &lt;b&gt;D.I.F.F.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

