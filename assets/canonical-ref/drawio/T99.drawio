Step Connector 3-&gt;4 --&gt;&lt;line x1=&quot;434&quot; y1=&quot;629&quot; x2=&quot;472&quot; y2=&quot;629&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;1.6&quot; stroke-dasharray=&quot;3 3&quot;/&gt;&lt;!-- Bar 4: O - Offload to Flash -$0.085 (y=629..705, h=76) --&gt;&lt;rect x=&quot;472&quot; y=&quot;629&quot; width=&quot;88&quot; height=&quot;76&quot; rx=&quot;12&quot; fill=&quot;#2563EB&quot;/&gt;&lt;text x=&quot;516&quot; y=&quot;672&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;13&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;-$0.085&lt;/text&gt;&lt;!-- Step Connector 4-&gt;5 --&gt;&lt;line x1=&quot;560&quot; y1=&quot;705&quot; x2=&quot;598&quot; y2=&quot;705&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;1.6&quot; stroke-dasharray=&quot;3 3&quot;/&gt;&lt;!-- Bar 5: P - Prune Verbose Tool JSON -$0.040 (y=705..741, h=36) --&gt;&lt;rect x=&quot;598&quot; y=&quot;705&quot; width=&quot;88&quot; height=&quot;36&quot; rx=&quot;10&quot; fill=&quot;#7C3AED&quot;/&gt;&lt;text x=&quot;642&quot; y=&quot;727&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;12&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;-$0.040&lt;/text&gt;&lt;!-- Step Connector 5-&gt;6 --&gt;&lt;line x1=&quot;686&quot; y1=&quot;741&quot; x2=&quot;728&quot; y2=&quot;741&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2&quot; stroke-dasharray=&quot;3 3&quot;/&gt;&lt;!-- Bar 6: S - Slim Prod Net Cost $0.030 (y=741..768, h=27) --&gt;&lt;rect x=&quot;728&quot; y=&quot;741&quot; width=&quot;96&quot; height=&quot;27&quot; rx=&quot;8&quot; fill=&quot;#064E3B&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2.5&quot;/&gt;&lt;text x=&quot;776&quot; y=&quot;729&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;16&quot; font-weight=&quot;900&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;$0.030&lt;/text&gt;&lt;/g&gt;&lt;!-- X-Axis Column Labels --&gt;&lt;text x=&quot;138&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#991B1B&quot; text-anchor=&quot;middle&quot;&gt;BASELINE&lt;/text&gt;&lt;text x=&quot;264&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;D • CACHE&lt;/text&gt;&lt;text x=&quot;390&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#0D9488&quot; text-anchor=&quot;middle&quot;&gt;R • LAZY MCP&lt;/text&gt;&lt;text x=&quot;516&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;O • FLASH&lt;/text&gt;&lt;text x=&quot;642&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;800&quot; fill=&quot;#7C3AED&quot; text-anchor=&quot;middle&quot;&gt;P • PRUNE&lt;/text&gt;&lt;text x=&quot;776&quot; y=&quot;789&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#064E3B&quot; text-anchor=&quot;middle&quot;&gt;S • PROD NET&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T99" value="&lt;div style='width:692px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#D1FAE5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #10 (T99) • CASCADING WATERFALL BRIDGE • FINOPS TOKEN ATTRIBUTION&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Agent FinOps: &lt;span style='color:#059669;'&gt;-93.7% Cost Waterfall&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;CFOs fund agents with unit economics — trace every cent from $0.48 burn down to $0.03 via &lt;b&gt;D.R.O.P.S.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="696" height="110" as="geometry"/></mxCell>

