      <mxCell id="w61_1" value="&lt;div style=&quot;padding:14px 15px;text-align:left;font-family:Inter,sans-serif;color:#0F172A;width:185px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;&quot;&gt;&lt;span style=&quot;font-size:16px;font-weight:900;line-height:1.18;&quot;&gt;SQL DATA&lt;br/&gt;AGENT&lt;/span&gt;&lt;span style=&quot;background:#BCE0C8;border:1.2px solid #0F172A;width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;&quot;&gt;02a&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display:inline-block;background:#2E8B46;color:#FFFFFF;padding:2.5px 9px;border-radius:9px;font-size:9px;font-weight:800;margin-top:8px;letter-spacing:0.3px;&quot;&gt;DATA ACCESS&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;line-height:1.32;color:#1E293B;&quot;&gt;Queries databases, joins datasets, and fetches structured schema information.&lt;/div&gt;&lt;div style=&quot;font-size:10.8px;margin-top:7px;line-height:1.4;color:#0F172A;font-weight:500;&quot;&gt;• Direct BigQuery &amp; SQL query&lt;br/&gt;• Retrieve relational tables&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C7E6D1;strokeColor=#0F172A;strokeWidth=1.4;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="215" height="189" as="geometry"/></mxCell>

      <mxCell id="w61_2" value="&lt;div style=&quot;padding:14px 15px;text-align:left;font-family:Inter,sans-serif;color:#0F172A;width:185px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;&quot;&gt;&lt;span style=&quot;font-size:16px;font-weight:900;line-height:1.18;&quot;&gt;WEB RESEARCHER&lt;br/&gt;AGENT&lt;/span&gt;&lt;span style=&quot;background:#F2CC7B;border:1.2px solid #0F172A;width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;&quot;&gt;02b&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display:inline-block;background:#B87A08;color:#FFFFFF;padding:2.5px 9px;border-radius:9px;font-size:9px;font-weight:800;margin-top:8px;letter-spacing:0.3px;&quot;&gt;BROWSER / SEARCH&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;line-height:1.32;color:#1E293B;&quot;&gt;Scrapes web pages, accesses APIs, and gathers real-time public information.&lt;/div&gt;&lt;div style=&quot;font-size:10.8px;margin-top:7px;line-height:1.4;color:#0F172A;font-weight:500;&quot;&gt;• Google Search API calls&lt;br/&gt;• Parse web content&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6D68B;strokeColor=#0F172A;strokeWidth=1.4;shadow=1;" vertex="1" parent="1"><mxGeometry x="275" y="445" width="215" height="189" as="geometry"/></mxCell>

      <mxCell id="w61_3" value="&lt;div style=&quot;padding:14px 15px;text-align:left;font-family:Inter,sans-serif;color:#0F172A;width:185px;box-sizing:border-box;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;&quot;&gt;&lt;span style=&quot;font-size:16px;font-weight:900;line-height:1.18;&quot;&gt;CODE SYNTHESIS&lt;br/&gt;AGENT&lt;/span&gt;&lt;span style=&quot;background:#F2B8B0;border:1.2px solid #0F172A;width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;&quot;&gt;02c&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display:inline-block;background:#C94438;color:#FFFFFF;padding:2.5px 9px;border-radius:9px;font-size:9px;font-weight:800;margin-top:8px;letter-spacing:0.3px;&quot;&gt;EXECUTION / WRITE&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:8px;line-height:1.32;color:#1E293B;&quot;&gt;Writes, tests, and refactors code scripts to process fetched datasets.&lt;/div&gt;&lt;div style=&quot;font-size:10.8px;margin-top:7px;line-height:1.4;color:#0F172A;font-weight:500;&quot;&gt;• Python/Node generation&lt;br/&gt;• Run test suite &amp; debug&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6C5BE;strokeColor=#0F172A;strokeWidth=1.4;shadow=1;" vertex="1" parent="1"><mxGeometry x="510" y="445" width="215" height="189" as="geometry"/></mxCell>

