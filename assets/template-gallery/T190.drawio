ound&quot;/&gt;&lt;path d=&quot;M 244 418 A 146 146 0 0 1 316 418&quot; fill=&quot;none&quot; stroke=&quot;#F59E0B&quot; stroke-width=&quot;24&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;path d=&quot;M 332 424 A 146 146 0 0 1 406 632&quot; fill=&quot;none&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;24&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;!-- Tachometer Hub + Needle Pointing to HIGH --&gt;&lt;circle cx=&quot;280&quot; cy=&quot;560&quot; r=&quot;92&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;line x1=&quot;280&quot; y1=&quot;560&quot; x2=&quot;364&quot; y2=&quot;478&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;5.5&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;circle cx=&quot;280&quot; cy=&quot;560&quot; r=&quot;14&quot; fill=&quot;#0F172A&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;3&quot;/&gt;&lt;text x=&quot;280&quot; y=&quot;596&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.2&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;thinkingLevel&lt;/text&gt;&lt;text x=&quot;280&quot; y=&quot;612&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.6&quot; font-weight=&quot;900&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;LOW • MEDIUM • HIGH&lt;/text&gt;&lt;!-- Gear Labels Outside Gauge --&gt;&lt;rect x=&quot;70&quot; y=&quot;458&quot; width=&quot;116&quot; height=&quot;44&quot; rx=&quot;10&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;128&quot; y=&quot;476&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;1. LOW (Fast)&lt;/text&gt;&lt;text x=&quot;128&quot; y=&quot;492&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;~120 tok • 380ms&lt;/text&gt;&lt;rect x=&quot;220&quot; y=&quot;362&quot; width=&quot;120&quot; height=&quot;42&quot; rx=&quot;10&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;280&quot; y=&quot;379&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;2. MEDIUM&lt;/text&gt;&lt;text x=&quot;280&quot; y=&quot;394&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#B45309&quot; text-anchor=&quot;middle&quot;&gt;~1.4k tok • Multi-Hop&lt;/text&gt;&lt;rect x=&quot;372&quot; y=&quot;458&quot; width=&quot;126&quot; height=&quot;44&quot; rx=&quot;10&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;435&quot; y=&quot;476&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;3. HIGH (Deep)&lt;/text&gt;&lt;text x=&quot;435&quot; y=&quot;492&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.2&quot; font-weight=&quot;800&quot; fill=&quot;#1D4ED8&quot; text-anchor=&quot;middle&quot;&gt;~8k+ tok • Proofs&lt;/text&gt;&lt;!-- Right Side: Encrypted Thought Signature Multi-Turn Baton Relay --&gt;&lt;rect x=&quot;524&quot; y=&quot;374&quot; width=&quot;328&quot; height=&quot;332&quot; rx=&quot;16&quot; fill=&quot;#F8FAFC&quot; stroke=&quot;#94A3B8&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;rect x=&quot;556&quot; y=&quot;388&quot; width=&quot;264&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;688&quot; y=&quot;403.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;ENCRYPTED THOUGHT SIGNATURE HANDOFF&lt;/text&gt;&lt