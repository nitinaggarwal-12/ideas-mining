    <mxCell id="hdr_T171" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEF3C7;color:#92400E;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T171) • TAPERED KNOCKOUT TORNADO VORTEX • ABLATION RIGOR&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Ablation Study: &lt;span style='color:#D97706;'&gt;Leave-1-Out A.B.L.A.T.E.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Prove every line of architecture earns its keep — rank module drops &amp;amp; prune bloat via &lt;b&gt;A.B.L.A.T.E.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

