etry"/></mxCell>

    <mxCell id="an_bad_T109" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ GOLDFISH MEMORY:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Re-explaining the &lt;b&gt;same build flags &amp;amp; repo gotchas&lt;/b&gt; every Monday morning&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T109" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ NAUTILUS S.P.I.R.A.L.:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Chambered shell growth&lt;/b&gt; — every human correction expands permanent capability&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="sp_tl" value="&lt;div style='width:388px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#2563EB;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;CHAMBERS 1 → 2 • S + P&lt;/span&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Zero Weight Updates&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Seed Solve + Parse Human Edit Diffs&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Whenever an engineer corrects an agent PR or SQL query, capture the exact before/after delta.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#2563EB;margin-top:4px;line-height:1.05;'&gt;100% Corrections Harvested&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="214" width="392" height="124" as="geometry"/></mxCell>
<mxCell id="sp_tr" value="&lt;div style='width:388px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#7C3AED;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;CHAMBER 3 • I&lt;/span&gt;&lt;span style='background:#F3E8FF;color:#6D28D9;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;SKILL.md Package&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Induce Reusable Procedural SKILL.md&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Distill repeated human fixes into a versioned SKILL.md + helper script (triggers, anti-patterns, CLI flags).&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#7C3AED;margin-top:4px;line-height:1.05;'&gt;1 Fix Teaches Whole Org&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="490" y="214" width="392" height="124" as="geometry"/></mxCell>
<mxCell id="sp_bl" value="&lt;div style='width:388px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#0D9488;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;CHAMBER 4 • R + A&lt;/span&gt;&lt;span style='background:#CCFBF1;color:#115E59;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Ablation Benchmarked&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Semantic Skill Router + Ablation Gate&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Keep only skills that prove &lt;b&gt;+Δ pass rate&lt;/b&gt; on held-out evals (with-skill vs. without-skill); archive bloat.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#0D9488;margin-top:4px;line-height:1.05;'&gt;+31pt Pass Without SFT&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="780" width="392" height="124" as="geometry"/></mxCell>
<mxCell id="sp_br" value="&lt;div style='width:388px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;'&gt;&lt;span style='background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;margin-right:5px;'&gt;CHAMBER 5 • L (S·P·I·R·A·L)&lt;/span&gt;&lt;span style='background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Compounding Moat&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Library Compounds Across Model Upgrades&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Fine-tuned LoRA weights break on next-gen models; markdown skills &lt;b&gt;compound immediately&lt;/b&gt; on Gemini 4.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;4.6× Faster Onboarding&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="392" height="124" as="geometry"/></mxCell>

    <mxCell id="c1_T109" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#7C3AED;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Prefer &lt;b&gt;ablation-tested SKILL.md libraries&lt;/b&gt; over brittle SFT for procedural workflows — zero GPU retraining &amp;amp; portable across models.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

