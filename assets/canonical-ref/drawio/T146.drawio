    <mxCell id="bg_T146" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT146&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT146&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT146)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT146&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT146)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;!-- Center Steel Flagpole Mast --&gt;&lt;g filter=&quot;url(#softDropT146)&quot;&gt;&lt;rect x=&quot;454&quot; y=&quot;362&quot; width=&quot;12&quot; height=&quot;398&quot; rx=&quot;6&quot; fill=&quot;#334155&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;356&quot; r=&quot;14&quot; fill=&quot;#F59E0B&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;396&quot; y=&quot;754&quot; width=&quot;128&quot; height=&quot;16&quot; rx=&quot;8&quot; fill=&quot;#0F172A&quot;/&gt;&lt;!-- Column Headers --&gt;&lt;rect x=&quot;140&quot; y=&quot;352&quot; width=&quot;210&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#DC2626&quot;/&gt;&lt;text x=&quot;245&quot; y=&quot;368.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;× CANDIDATE RED FLAGS&lt;/text&gt;&lt;rect x=&quot;570&quot; y=&quot;352&quot; width=&quot;210&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;675&quot; y=&quot;368.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;✓ STRONG-HIRE GREEN FLAGS&lt;/text&gt;&lt;!-- 4 Opposing Pennant Pairs --&gt;&lt;!-- Center Topic Collar on Mast --&gt;&lt;rect x=&quot;418&quot; y=&quot;416&quot; width=&quot;84&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;431.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;1. STACK&lt;/text&gt;&lt;!-- Left Crimson Pennant Flag (Pointing Left) --&gt;&lt;polygon points=&quot;418,404 88,404 62,428 88,452 418,452&quot; fill=&quot;#FFF1F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;404&quot; y=&quot;424&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;end&quot;&gt;🚩 &quot;I use 15 agent frameworks!&quot;&lt;/text&gt;&lt;text x=&quot;404&quot; y=&quot;442&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;end&quot;&gt;Chases Twitter hype without shipping 1&lt;/text&gt;&lt;!-- Right Emerald Pennant Flag (Pointing Right) --&gt;&lt;polygon points=&quot;502,404 832,404 858,428 832,452 502,452&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;516&quot; y=&quot;424&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot;&gt;✓ &quot;We picked ADK over X because...&quot;&lt;/text&gt;&lt;text x=&quot;516&quot; y=&quot;442&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#047857&quot;&gt;Explains concrete failure &amp;amp; latency trade-offs&lt;/text&gt;&lt;!-- Center Topic Collar on Mast --&gt;&lt;rect x=&quot;418&quot; y=&quot;502&quot; width=&quot;84&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;517.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;2. QUALITY&lt;/text&gt;&lt;!-- Left Crimson Pennant Flag (Pointing Left) --&gt;&lt;polygon points=&quot;418,490 88,490 62,514 88,538 418,538&quot; fill=&quot;#FFF1F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;404&quot; y=&quot;510&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;end&quot;&gt;🚩 &quot;It got 98% on my 5 test prompts&quot;&lt;/text&gt;&lt;text x=&quot;404&quot; y=&quot;528&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;end&quot;&gt;Vibes testing — blind to tail failures&lt;/text&gt;&lt;!-- Right Emerald Pennant Flag (Pointing Right) --&gt;&lt;polygon points=&quot;502,490 832,490 858,514 832,538 502,538&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;516&quot; y=&quot;510&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot;&gt;✓ &quot;94.2% pass^5 on 200 prod traces&quot;&lt;/text&gt;&lt;text x=&quot;516&quot; y=&quot;528&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#047857&quot;&gt;Quotes multi-run consistency &amp;amp; CI regression gate&lt;/text&gt;&lt;!-- Center Topic Collar on Mast --&gt;&lt;rect x=&quot;418&quot; y=&quot;588&quot; width=&quot;84&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;603.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;3. SECURITY&lt;/text&gt;&lt;!-- Left Crimson Pennant Flag (Pointing Left) --&gt;&lt;polygon points=&quot;418,576 88,576 62,600 88,624 418,624&quot; fill=&quot;#FFF1F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;404&quot; y=&quot;596&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;end&quot;&gt;🚩 &quot;The system prompt forbids leaks&quot;&lt;/text&gt;&lt;text x=&quot;404&quot; y=&quot;614&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;end&quot;&gt;Confuses prompt text with access control&lt;/text&gt;&lt;!-- Right Emerald Pennant Flag (Pointing Right) --&gt;&lt;polygon points=&quot;502,576 832,576 858,600 832,624 502,624&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;516&quot; y=&quot;596&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot;&gt;✓ &quot;OAuth 2.1 OBO + DB pre-filter RLS&quot;&lt;/text&gt;&lt;text x=&quot;516&quot; y=&quot;614&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#047857&quot;&gt;Enforces permissions deterministically below LLM&lt;/text&gt;&lt;!-- Center Topic Collar on Mast --&gt;&lt;rect x=&quot;418&quot; y=&quot;674&quot; width=&quot;84&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;689.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#38BDF8&quot; text-anchor=&quot;middle&quot;&gt;4. END Q&amp;amp;A&lt;/text&gt;&lt;!-- Left Crimson Pennant Flag (Pointing Left) --&gt;&lt;polygon points=&quot;418,662 88,662 62,686 88,710 418,710&quot; fill=&quot;#FFF1F2&quot; stroke=&quot;#EF4444&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;404&quot; y=&quot;682&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#B91C1C&quot; text-anchor=&quot;end&quot;&gt;🚩 &quot;What is a typical day like here?&quot;&lt;/text&gt;&lt;text x=&quot;404&quot; y=&quot;700&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;end&quot;&gt;Generic filler wastes final 5 minutes&lt;/text&gt;&lt;!-- Right Emerald Pennant Flag (Pointing Right) --&gt;&lt;polygon points=&quot;502,662 832,662 858,686 832,710 502,710&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#10B981&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;516&quot; y=&quot;682&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot;&gt;✓ &quot;What blocks AI deploys to prod today?&quot;&lt;/text&gt;&lt;text x=&quot;516&quot; y=&quot;700&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#047857&quot;&gt;Diagnoses team bottlenecks like an insider&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T146" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEE2E2;color:#991B1B;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #57 (T146) • LINKEDIN VIRAL DEBATE &amp; SAVE • RED VS. GREEN FLAGS&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Interview Signals: &lt;span style='color:#059669;'&gt;Red/Green F.L.A.G.S.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;4 phrases get AI candidates rejected in 8 minutes — swap them for Strong-Hire &lt;b&gt;F.L.A.G.S.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

