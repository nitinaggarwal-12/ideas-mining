    <mxCell id="bg_T179" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;920&quot; height=&quot;1150&quot; viewBox=&quot;0 0 920 1150&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;minorGridT179&quot; width=&quot;20&quot; height=&quot;20&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 20 0 L 0 0 0 20&quot; fill=&quot;none&quot; stroke=&quot;#EAE4D7&quot; stroke-width=&quot;0.65&quot;/&gt;&lt;/pattern&gt;&lt;pattern id=&quot;majorGridT179&quot; width=&quot;80&quot; height=&quot;80&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;rect width=&quot;80&quot; height=&quot;80&quot; fill=&quot;url(#minorGridT179)&quot;/&gt;&lt;path d=&quot;M 80 0 L 0 0 0 80&quot; fill=&quot;none&quot; stroke=&quot;#DFD8C8&quot; stroke-width=&quot;1.05&quot;/&gt;&lt;/pattern&gt;&lt;filter id=&quot;softDropT179&quot; x=&quot;-12%&quot; y=&quot;-10%&quot; width=&quot;124%&quot; height=&quot;124%&quot;&gt;&lt;feDropShadow dx=&quot;0&quot; dy=&quot;8&quot; stdDeviation=&quot;9&quot; flood-color=&quot;#0F172A&quot; flood-opacity=&quot;0.13&quot;/&gt;&lt;/filter&gt;&lt;/defs&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;#FAF8F2&quot;/&gt;&lt;rect width=&quot;920&quot; height=&quot;1150&quot; fill=&quot;url(#majorGridT179)&quot;/&gt;&lt;rect x=&quot;22&quot; y=&quot;200&quot; width=&quot;876&quot; height=&quot;764&quot; rx=&quot;24&quot; fill=&quot;#FFFFFF&quot; fill-opacity=&quot;0.68&quot; stroke=&quot;#E2E8F0&quot; stroke-width=&quot;1.2&quot;/&gt;&lt;g filter=&quot;url(#softDropT179)&quot;&gt;&lt;rect x=&quot;48&quot; y=&quot;348&quot; width=&quot;824&quot; height=&quot;416&quot; rx=&quot;18&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;!-- Sequential Posterior Equation Pill --&gt;&lt;rect x=&quot;222&quot; y=&quot;366&quot; width=&quot;476&quot; height=&quot;32&quot; rx=&quot;16&quot; fill=&quot;#0F172A&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;386.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#FDE68A&quot; text-anchor=&quot;middle&quot;&gt;P(H | E₁..ₖ)  ∝  P(E₁..ₖ | H)  ×  P(H)   [Sequential Log-Odds]&lt;/text&gt;&lt;!-- Baseline Axis --&gt;&lt;line x1=&quot;92&quot; y1=&quot;696&quot; x2=&quot;836&quot; y2=&quot;696&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;2.4&quot;/&gt;&lt;line x1=&quot;92&quot; y1=&quot;414&quot; x2=&quot;92&quot; y2=&quot;696&quot; stroke=&quot;#0F172A&quot; stroke-width=&quot;2.2&quot;/&gt;&lt;!-- 1. Broad Flat Dashed Prior Curve P(H) --&gt;&lt;path d=&quot;M 108 694 C 190 690, 236 568, 336 568 C 436 568, 482 690, 620 694&quot; fill=&quot;#E2E8F0&quot; fill-opacity=&quot;0.45&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;2.8&quot; stroke-dasharray=&quot;7 5&quot;/&gt;&lt;rect x=&quot;150&quot; y=&quot;528&quot; width=&quot;184&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#64748B&quot; stroke-width=&quot;1.4&quot;/&gt;&lt;text x=&quot;242&quot; y=&quot;544.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;1. Broad Prior P(H) (Turn 0)&lt;/text&gt;&lt;!-- 2. Medium Blue Tool Evidence Likelihood P(E|H) --&gt;&lt;path d=&quot;M 280 694 C 378 690, 424 494, 514 494 C 604 494, 650 690, 760 694&quot; fill=&quot;#DBEAFE&quot; fill-opacity=&quot;0.45&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;3.2&quot;/&gt;&lt;rect x=&quot;336&quot; y=&quot;454&quot; width=&quot;212&quot; height=&quot;26&quot; rx=&quot;13&quot; fill=&quot;#EFF6FF&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;1.5&quot;/&gt;&lt;text x=&quot;442&quot; y=&quot;470.5&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;900&quot; fill=&quot;#1E40AF&quot; text-anchor=&quot;middle&quot;&gt;2. Diagnostic Tool Likelihood P(E|H)&lt;/text&gt;&lt;!-- 3. Tall Sharp Emerald Posterior P(H|E) + 95% Credible Band --&gt;&lt;path d=&quot;M 484 694 C 556 692, 594 446, 646 446 C 698 446, 736 692, 808 694&quot; fill=&quot;#A7F3D0&quot; fill-opacity=&quot;0.62&quot; stroke=&quot;#059669&quot; stroke-width=&quot;4.2&quot;/&gt;&lt;rect x=&quot;598&quot; y=&quot;408&quot; width=&quot;232&quot; height=&quot;28&quot; rx=&quot;14&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;714&quot; y=&quot;426&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#FFFFFF&quot; text-anchor=&quot;middle&quot;&gt;★ 3. Sharp Posterior P(H|E) = 0.96&lt;/text&gt;&lt;!-- Beliefs Shift Arrow --&gt;&lt;line x1=&quot;336&quot; y1=&quot;628&quot; x2=&quot;612&quot; y2=&quot;628&quot; stroke=&quot;#059669&quot; stroke-width=&quot;3&quot; stroke-dasharray=&quot;5 3&quot;/&gt;&lt;polygon points=&quot;608,622 622,628 608,634&quot; fill=&quot;#059669&quot;/&gt;&lt;rect x=&quot;384&quot; y=&quot;615&quot; width=&quot;184&quot; height=&quot;24&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.4&quot;/&gt;&lt;text x=&quot;476&quot; y=&quot;630.5&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.8&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;Info Gain: +2.84 Bits (EIG)&lt;/text&gt;&lt;text x=&quot;464&quot; y=&quot;722&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;ROOT-CAUSE HYPOTHESIS PARAMETER SPACE  (θ →)&lt;/text&gt;&lt;text x=&quot;464&quot; y=&quot;746&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;9.2&quot; font-weight=&quot;800&quot; fill=&quot;#047857&quot; text-anchor=&quot;middle&quot;&gt;ACTIVE SENSING RULE: Pick next tool call maximizing Expected Information Gain  arg maxₐ I(H ; Eₐ)&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T179" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#ECFDF5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #90 (T179) • LINKEDIN PROBABILISTIC ML &amp; SCIENCE HIT • POSTERIOR UPDATE&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Active Inference: &lt;span style='color:#059669;'&gt;Posterior P.R.I.O.R. Shift&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stop confirmation-bias loops — choose each agent tool call by Expected Information Gain via &lt;b&gt;P.R.I.O.R.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T179" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;188&quot; height=&quot;52&quot; viewBox=&quot;0 0 188 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;186&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M35.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M29.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M38.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M31.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;35&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.2&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;71&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M131 9.5 C131 16 136 21 142.5 21 C136 21 131 26 131 32.5 C131 26 126 21 119.5 21 C126 21 131 16 131 9.5 Z&quot; fill=&quot;#059669&quot;/&gt;&lt;text x=&quot;131&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;7.9&quot; font-weight=&quot;700&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;Optimal Exp Design&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="716" y="26" width="188" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T179" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ 20 RANDOM YES/NO GUESSES:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Asking narrow confirmatory questions about 1 lucky guess&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T179" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ BINARY-SEARCH ENTROPY HALVING:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Pick probe splitting prior mass 50/50 → converge in 3 turns&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="by_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;PREMATURE HYPOTHESIS LOCK-IN&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Confirmation Bias&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Guessing 1 Root Cause at Turn 1 &amp;amp; Ignoring Contradictions&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Standard agents commit to their first hunch and run 6 redundant queries instead of &lt;b&gt;testing competing hypotheses&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;3.6× Wasted Tool Calls&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="by_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;EXPECTED INFO GAIN (EIG)&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Active Posterior Search&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Maintain Explicit Hypothesis Weights &amp;amp; Query Max-EIG Probe&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Track &lt;b&gt;K=4&lt;/b&gt; candidate hypotheses in state and choose the single tool query that &lt;b&gt;halves posterior entropy fastest&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;64% Fewer Diagnostic Turns&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="by_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: P · R · I · O · R&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#ECFDF5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Probabilistic Reasoning&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Populate K Hypotheses • Rank Explicit Priors • Identify Max-EIG Probe • Observe Likelihood Log-Odds • Resolve at Posterior ≥ 0.95&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Sequential optimal experimental design (&lt;b&gt;OED&lt;/b&gt;) is the math behind top &lt;b&gt;clinical-diagnosis, SRE-triage, and AI scientist agents&lt;/b&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T179" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#059669;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Instead of greedy ReAct, our diagnostic agent maintains a &lt;b&gt;posterior over K hypotheses&lt;/b&gt; and selects the tool call maximizing &lt;b&gt;Expected Information Gain&lt;/b&gt;.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c2_T179" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#0F766E;letter-spacing:0.4px;'&gt;▲ DAY-1 GCP ⇄ OSS STACK&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&lt;b&gt;Google ADK State + Gemini 4 Argon&lt;/b&gt; ⇄ Pyro / NumPyro + Active OED Scoring&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="c3_T179" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#047857;letter-spacing:0.4px;'&gt;★ L5 → L7 PROMO IMPACT&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;Cut automated root-cause triage from &lt;b&gt;11.4 tool calls to 3.9&lt;/b&gt; (+27% accuracy)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="984" width="274" height="94" as="geometry"/></mxCell>

    <mxCell id="ftr_T179" value="&lt;span style='font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;font-size:10.8px;font-weight:800;letter-spacing:0.5px;'&gt;NITIN AGGARWAL • NOVEMBER 2026 • CANONICAL TEMPLATE T179 (SEQUENTIAL POSTERIOR SHIFT) • REPO: generated-repos/prior-eig-diagnostic-agent&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="1112" width="920" height="38" as="geometry"/></mxCell>
