    <mxCell id="hdr_T121" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#FEE2E2;color:#991B1B;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #32 (T121) • YOUTUBE SECURITY POSTMORTEM • 3× FORENSIC LENS&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;RAG Injection: &lt;span style='color:#0284C7;'&gt;Forensic A.L.I.B.I.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Put indirect prompt injection under a 3× lens — isolate untrusted docs from tool control flow via &lt;b&gt;A.L.I.B.I.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

