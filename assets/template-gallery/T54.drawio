      <mxCell id="poster_bg" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;1075&quot; height=&quot;1310&quot; viewBox=&quot;0 0 1075 1310&quot; style=&quot;display:block;&quot;&gt;&lt;defs&gt;&lt;pattern id=&quot;grid53&quot; width=&quot;53.75&quot; height=&quot;53.75&quot; patternUnits=&quot;userSpaceOnUse&quot;&gt;&lt;path d=&quot;M 53.75 0 L 0 0 0 53.75&quot; fill=&quot;none&quot; stroke=&quot;#EDF2F9&quot; stroke-width=&quot;1&quot;/&gt;&lt;/pattern&gt;&lt;/defs&gt;&lt;rect width=&quot;1075&quot; height=&quot;1310&quot; fill=&quot;#FCFDFE&quot;/&gt;&lt;rect width=&quot;1075&quot; height=&quot;1310&quot; fill=&quot;url(#grid53)&quot;/&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1075" height="1310" as="geometry"/></mxCell>

