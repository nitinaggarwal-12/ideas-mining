ot; stroke-width=&quot;1.6&quot;/&gt;&lt;text x=&quot;688&quot; y=&quot;637&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.4&quot; font-weight=&quot;900&quot; fill=&quot;#991B1B&quot; text-anchor=&quot;middle&quot;&gt;✕ Common SDK Bug: Stripping Signature&lt;/text&gt;&lt;text x=&quot;688&quot; y=&quot;655&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.3&quot; font-weight=&quot;800&quot; fill=&quot;#DC2626&quot; text-anchor=&quot;middle&quot;&gt;Dropping thoughtSignature breaks tool chain&lt;/text&gt;&lt;text x=&quot;688&quot; y=&quot;672&quot; font-family=&quot;Courier New,monospace&quot; font-size=&quot;8.3&quot; font-weight=&quot;900&quot; fill=&quot;#7F1D1D&quot; text-anchor=&quot;middle&quot;&gt;Fix: Forward raw model parts[] verbatim!&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;738&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;GEMINI API CONTRACT: Replace legacy numeric thinkingBudget with discrete thinkingLevel + Thought Signatures!&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

