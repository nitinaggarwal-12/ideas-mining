    <mxCell id="an_bad_T205" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ READING ONLY THE FIRST SEARCH RESULT:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;Writing a board memo from 3 unverified snippets&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T205" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ AUTONOMOUS MULTI-HOP RESEARCHER:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;Plan → search web &amp;amp; Drive → verify conflicts → cited brief&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="dr_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;1-HOP TOP-5 RAG SUMMARY&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Shallow Surface Answer&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Answering Executive Strategy Questions From 5 Snippets&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Single-query RAG reads 5 paragraphs and stops—&lt;b&gt;missing cross-document contradictions, primary tables, and internal specs&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;6 Hours Manual Fact-Check&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="dr_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#059669;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;GEMINI DEEP RESEARCH AGENT&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#D1FAE5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Multi-Hop Synthesis&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Plan, Search, Read 80+ Sources &amp;amp; Cross-Verify Automatically&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;&lt;b&gt;Gemini Deep Research&lt;/b&gt; iteratively refines sub-queries across public web + enterprise silos to emit &lt;b&gt;cited briefings&lt;/b&gt;.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#059669;margin-top:4px;line-height:1.05;'&gt;10× Faster Cited Dossiers&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="dr_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: D · E · E · P · S&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DBEAFE;color:#1E40AF;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;Deep Research Agent&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Decompose Complex Questions Into Research Plan • Explore Public Web + Enterprise Connectors • Evaluate Source Credibility Across Hops • Prune Contradictory or Stale Claims • Synthesize Cited Executive Briefing Reports&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Always review and approve the &lt;b&gt;generated research plan&lt;/b&gt; before launching the deep crawl so scope and source boundaries are exact.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

