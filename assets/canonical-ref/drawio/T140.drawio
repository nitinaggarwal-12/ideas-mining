 y=&quot;340&quot; width=&quot;196&quot; height=&quot;32&quot; rx=&quot;10&quot; fill=&quot;#DCFCE7&quot; stroke=&quot;#059669&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;704&quot; y=&quot;360&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#065F46&quot; text-anchor=&quot;middle&quot;&gt;SIGNED: $328k / YR (+$93k)&lt;/text&gt;&lt;!-- Lever 4: Sign-On + 6m Review $20k (h=44, y=380..424) --&gt;&lt;rect x=&quot;606&quot; y=&quot;380&quot; width=&quot;196&quot; height=&quot;44&quot; rx=&quot;8&quot; fill=&quot;#FEF3C7&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;704&quot; y=&quot;406&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#92400E&quot; text-anchor=&quot;middle&quot;&gt;Sign-On: +$20k Yr-1&lt;/text&gt;&lt;!-- Lever 3: RSU Equity $72k/yr (h=92, y=424..516) --&gt;&lt;rect x=&quot;606&quot; y=&quot;424&quot; width=&quot;196&quot; height=&quot;92&quot; fill=&quot;#EDE9FE&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;704&quot; y=&quot;466&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11.5&quot; font-weight=&quot;900&quot; fill=&quot;#5B21B6&quot; text-anchor=&quot;middle&quot;&gt;RSU Grant: $72k/yr ★&lt;/text&gt;&lt;text x=&quot;704&quot; y=&quot;484&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;700&quot; fill=&quot;#6D28D9&quot; text-anchor=&quot;middle&quot;&gt;$288k / 4yr top-of-band&lt;/text&gt;&lt;!-- Lever 2: Bonus $31k (h=46, y=516..562) --&gt;&lt;rect x=&quot;606&quot; y=&quot;516&quot; width=&quot;196&quot; height=&quot;46&quot; fill=&quot;#E0F2FE&quot; stroke=&quot;#0284C7&quot; stroke-width=&quot;2&quot;/&gt;&lt;text x=&quot;704&quot; y=&quot;543&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.5&quot; font-weight=&quot;900&quot; fill=&quot;#075985&quot; text-anchor=&quot