5&quot; font-weight=&quot;900&quot; fill=&quot;#2563EB&quot; text-anchor=&quot;middle&quot;&gt;1. SITUATION • 15s (12%)&lt;/text&gt;&lt;text x=&quot;132&quot; y=&quot;593&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;1-Line Prod Scale&lt;/text&gt;&lt;text x=&quot;132&quot; y=&quot;609&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;3M turns/mo billing agent&lt;/text&gt;&lt;line x1=&quot;262&quot; y1=&quot;522&quot; x2=&quot;274&quot; y2=&quot;583&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.8&quot; stroke-dasharray=&quot;4 3&quot;/&gt;&lt;circle cx=&quot;274&quot; cy=&quot;596&quot; r=&quot;13&quot; fill=&quot;#D97706&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;186&quot; y=&quot;460&quot; width=&quot;152&quot; height=&quot;62&quot; rx=&quot;12&quot; fill=&quot;#FFFBEB&quot; stroke=&quot;#D97706&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;262&quot; y=&quot;479&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#D97706&quot; text-anchor=&quot;middle&quot;&gt;2. TENSION • 25s (20%)&lt;/text&gt;&lt;text x=&quot;262&quot; y=&quot;497&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Hard Stakes &amp;amp; Risk&lt;/text&gt;&lt;text x=&quot;262&quot; y=&quot;513&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;$42k retry spike + SEV-1&lt;/text&gt;&lt;line x1=&quot;460&quot; y1=&quot;428&quot; x2=&quot;460&quot; y2=&quot;439&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.8&quot; stroke-dasharray=&quot;4 3&quot;/&gt;&lt;circle cx=&quot;460&quot; cy=&quot;452&quot; r=&quot;13&quot; fill=&quot;#059669&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;384&quot; y=&quot;366&quot; width=&quot;152&quot; height=&quot;62&quot; rx=&quot;12&quot; fill=&quot;#ECFDF5&quot; stroke=&quot;#059669&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;460&quot; y=&quot;385&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#059669&quot; text-anchor=&quot;middle&quot;&gt;3. ACTION ★ PEAK • 50s (42%)&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;403&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;&quot;I Chose X Over Y&quot;&lt;/text&gt;&lt;text x=&quot;460&quot; y=&quot;419&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;Your trade-off &amp;amp; design&lt;/text&gt;&lt;line x1=&quot;646&quot; y1=&quot;594&quot; x2=&quot;646&quot; y2=&quot;579&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;1.8&quot; stroke-dasharray=&quot;4 3&quot;/&gt;&lt;circle cx=&quot;646&quot; cy=&quot;566&quot; r=&quot;13&quot; fill=&quot;#0D9488&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;570&quot; y=&quot;594&quot; width=&quot;152&quot; height=&quot;62&quot; rx=&quot;12&quot; fill=&quot;#F0FDFA&quot; stroke=&quot;#0D9488&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;646&quot; y=&quot;613&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#0D9488&quot; text-anchor=&quot;middle&quot;&gt;4. RESULT • 15s (13%)&lt;/text&gt;&lt;text x=&quot;646&quot; y=&quot;631&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Quantified Delta&lt;/text&gt;&lt;text x=&quot;646&quot; y=&quot;647&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;-94% cost • 0 incidents&lt;/text&gt;&lt;line x1=&quot;784&quot; y1=&quot;480&quot; x2=&quot;800&quot; y2=&quot;495&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;1.8&quot; stroke-dasharray=&quot;4 3&quot;/&gt;&lt;circle cx=&quot;800&quot; cy=&quot;508&quot; r=&quot;13&quot; fill=&quot;#7C3AED&quot; stroke=&quot;#FFFFFF&quot; stroke-width=&quot;3&quot;/&gt;&lt;rect x=&quot;708&quot; y=&quot;418&quot; width=&quot;152&quot; height=&quot;62&quot; rx=&quot;12&quot; fill=&quot;#F5F3FF&quot; stroke=&quot;#7C3AED&quot; stroke-width=&quot;1.8&quot;/&gt;&lt;text x=&quot;784&quot; y=&quot;437&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.5&quot; font-weight=&quot;900&quot; fill=&quot;#7C3AED&quot; text-anchor=&quot;middle&quot;&gt;5. +LESSON • 15s (13%)&lt;/text&gt;&lt;text x=&quot;784&quot; y=&quot;455&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;10.8&quot; font-weight=&quot;900&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;Org Mechanism&lt;/text&gt;&lt;text x=&quot;784&quot; y=&quot;471&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;9.2&quot; font-weight=&quot;700&quot; fill=&quot;#475569&quot; text-anchor=&quot;middle&quot;&gt;Codified CI gate for 12 teams&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="920" height="1150" as="geometry"/></mxCell>

    <mxCell id="hdr_T136" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#F3E8FF;color:#6D28D9;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;BLUEPRINT #47 (T136) • LINKEDIN BEHAVIORAL INTERVIEW HIT • STAR+L STORY MOUNTAIN&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Behavioral Loop: &lt;span style='color:#7C3AED;'&gt;2-Min S.T.O.R.Y. Arc&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;Stop rambling in behavioral interviews — ride the 120-second &lt;b&gt;STAR+L S.T.O.R.Y.&lt;/b&gt; mountain to a Strong Hire&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

    <mxCell id="brand_T136" value="&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;174&quot; height=&quot;52&quot; viewBox=&quot;0 0 174 52&quot; style=&quot;display:block;&quot;&gt;&lt;rect x=&quot;1&quot; y=&quot;1&quot; width=&quot;172&quot; height=&quot;50&quot; rx=&quot;12&quot; fill=&quot;#FFFFFF&quot; stroke=&quot;#CBD5E1&quot; stroke-width=&quot;1.3&quot;/&gt;&lt;path d=&quot;M36.5 13c-2.8 0-5.2 1.6-6.3 4l3.1 2.4c.6-1.4 1.8-2.4 3.2-2.4 1.6 0 3 1.1 3.4 2.6l3.3-1.9c-1.2-2.8-3.8-4.7-6.7-4.7z&quot; fill=&quot;#EA4335&quot;/&gt;&lt;path d=&quot;M30.2 17c-.8.8-1.5 1.9-1.7 3.2-.4 2.7 1.3 5.2 4 5.7l1.1-3.6c-1-.2-1.7-1.1-1.5-2.1.1-.5.4-1 .8-1.3l-2.7-1.9z&quot; fill=&quot;#FBBC05&quot;/&gt;&lt;path d=&quot;M39.9 19.6c.1.4.1.9 0 1.4-.2 1.2-1.2 2.1-2.5 2.1h-4.9v3.8h5c3.2 0 5.9-2.3 6.3-5.4.2-1.4-.1-2.7-.8-3.8l-3.1 1.9z&quot; fill=&quot;#4285F4&quot;/&gt;&lt;path d=&quot;M32.5 23.1h4.9v3.8h-4.9c-.6 0-1.2-.1-1.8-.3l1.8-3.5z&quot; fill=&quot;#34A853&quot;/&gt;&lt;text x=&quot;36&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.4&quot; font-weight=&quot;700&quot; fill=&quot;#334155&quot; text-anchor=&quot;middle&quot;&gt;Google Cloud&lt;/text&gt;&lt;text x=&quot;74&quot; y=&quot;28&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;11&quot; font-weight=&quot;700&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;middle&quot;&gt;+&lt;/text&gt;&lt;path d=&quot;M124 9.5 C124 16 129 21 135.5 21 C129 21 124 26 124 32.5 C124 26 119 21 112.5 21 C119 21 124 16 124 9.5 Z&quot; fill=&quot;#7C3AED&quot;/&gt;&lt;text x=&quot;124&quot; y=&quot;40&quot; font-family=&quot;Arial,sans-serif&quot; font-size=&quot;8.1&quot; font-weight=&quot;700&quot; fill=&quot;#7C3AED&quot; text-anchor=&quot;middle&quot;&gt;Leadership + L6 Bar&lt;/text&gt;&lt;/svg&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;overflow=visible;" vertex="1" parent="1"><mxGeometry x="722" y="26" width="174" height="52" as="geometry"/></mxCell>

    <mxCell id="an_bad_T136" value="&lt;div style='width:414px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#991B1B;'&gt;✕ 4-MINUTE CHRONOLOGICAL DIARY:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;i&gt;&amp;ldquo;First our PM had a meeting, then we tried X...&amp;rdquo;&lt;/i&gt; — zero ownership signal&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="26" y="140" width="424" height="46" as="geometry"/></mxCell>

    <mxCell id="an_good_T136" value="&lt;div style='width:426px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:8px 14px;box-sizing:border-box;'&gt;&lt;span style='font-size:10.8px;font-weight:900;color:#065F46;'&gt;✓ PEAK TRADE-OFF + ORG +L:&lt;/span&gt; &lt;span style='font-size:12.2px;color:#0F172A;font-weight:600;'&gt;&lt;b&gt;40s context/stakes → 50s YOUR trade-off → 30s delta + CI mechanism&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="462" y="140" width="434" height="46" as="geometry"/></mxCell>

    <mxCell id="st_tl" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#DC2626;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;BEHAVIORAL SILENT KILLER&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#FEE2E2;color:#991B1B;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;90s Backstory Trap&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Spending 3 Minutes on Backstory &amp;amp; Saying &amp;ldquo;We&amp;rdquo; Everywhere&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;If the interviewer still doesn&amp;rsquo;t know what &lt;b&gt;YOU&lt;/b&gt; specifically decided by second 45, they cannot defend you in debrief.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#DC2626;margin-top:4px;line-height:1.05;'&gt;#1 Senior/Staff Reject Reason&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="38" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="st_tr" value="&lt;div style='width:400px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#7C3AED;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;THE +L STAFF+ SECRET&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#F3E8FF;color:#6D28D9;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;STAR + Institutional Lesson&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;End Every Story With the Mechanism You Left Behind&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;L5 fixes the bug; &lt;b&gt;L6+ turns the postmortem into an automated CI gate or SKILL.md&lt;/b&gt; so nobody in the org hits it again.&lt;/div&gt;&lt;div style='font-size:19px;font-weight:900;color:#7C3AED;margin-top:4px;line-height:1.05;'&gt;Instant Staff+ Maturity Signal&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="478" y="212" width="404" height="120" as="geometry"/></mxCell>
<mxCell id="st_bot" value="&lt;div style='width:832px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;background:#F8FAFC;border:1.4px solid #CBD5E1;border-radius:16px;padding:9px 13px;box-sizing:border-box;'&gt;&lt;div style='margin-bottom:4px;display:flex;flex-wrap:wrap;gap:5px;align-items:center;justify-content:flex-start;'&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#0F172A;color:#FFFFFF;font-size:10.2px;font-weight:900;padding:2px 8px;border-radius:999px;'&gt;MNEMONIC: S · T · O · R · Y&lt;/span&gt;&lt;span style='display:inline-block;white-space:nowrap;background:#ECFDF5;color:#065F46;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;'&gt;120-Second Stopwatch Rule&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:15.5px;font-weight:800;color:#0F172A;line-height:1.18;'&gt;Scale Context (15s) • Tension Stakes (25s) • Own Trade-Off (50s) • Result Delta (15s) • Yield Org Guardrail (15s)&lt;/div&gt;&lt;div style='font-size:12px;color:#334155;margin-top:3px;line-height:1.32;'&gt;Prepare &lt;b&gt;5 master S.T.O.R.Y. cards&lt;/b&gt; (Prod Outage, Disagreement, Ambiguity, Cost Cut, Security Catch) to cover 95% of questions.&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="42" y="788" width="836" height="122" as="geometry"/></mxCell>

    <mxCell id="c1_T136" value="&lt;div style='width:266px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;padding:10px 14px;box-sizing:border-box;'&gt;&lt;div style='font-size:10.5px;font-weight:800;color:#7C3AED;letter-spacing:0.4px;'&gt;◆ 30s STAFF+ INTERVIEW PITCH&lt;/div&gt;&lt;div style='font-size:12.3px;color:#0F172A;margin-top:4px;line-height:1.33;'&gt;&amp;ldquo;Cap every answer at &lt;b&gt;120 seconds&lt;/b&gt;, use &lt;b&gt;&amp;lsquo;I&amp;rsquo;&lt;/b&gt; for your architectural trade-off, and close with the &lt;b&gt;CI mechanism&lt;/b&gt; you institutionalized.&amp;rdquo;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="26" y="984" width="274" height="94" as="geometry"/></mxCell>

