    <mxCell id="hdr_T124" value="&lt;div style='width:678px;font-family:Inter,-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;text-align:left;white-space:normal;'&gt;&lt;div style='display:inline-block;background:#ECFDF5;color:#065F46;font-size:10.8px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:0.5px;margin-bottom:6px;'&gt;CERTIFIED GEN-5 BEST (T124) • HAIRBALL VS LINEAR VECTOR DIPTYCH • TYPED ADK DAG&lt;/div&gt;&lt;div style='font-size:35px;font-weight:900;color:#0F172A;letter-spacing:-0.85px;line-height:1.08;'&gt;Swarm Fallacy: &lt;span style='color:#059669;'&gt;Minimal S.I.G.N.A.L.&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:14.5px;font-weight:500;color:#334155;margin-top:6px;line-height:1.25;'&gt;10 chattering persona bots create 45 noisy edges — 3 typed &lt;b&gt;S.I.G.N.A.L.&lt;/b&gt; stages win in 200ms&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="32" y="18" width="682" height="110" as="geometry"/></mxCell>

